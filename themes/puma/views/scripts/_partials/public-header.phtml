/**
 * PUMA public header — the marketing/site navbar (MIT, Tiger-original).
 *
 * Layout: [ brand ] [ main menu ] [ · search region · ] [ utility switchers ] [ sign up ] [ sign in ]
 *
 * Two header REGIONS let a feature contribute chrome without this theme file knowing about
 * it (the two-step view renders the action script first, so a view script can fill a region
 * that the layout — and this header — read afterward):
 *   - `tigerHeaderSearch` — the centered slot; a feature drops a search trigger here
 *     (TigerDocs fills it with its ⌘K launcher). Empty on pages that don't use it.
 *   - `tigerHeaderAuth`   — the sign-up/sign-in/dashboard slot; the theme renders a sensible
 *     default (below), but a feature may override the whole region.
 *
 * Behavior (switchers, prefs) lives in tiger.prefs.js.
 */
$identity   = Zend_Auth::getInstance()->hasIdentity() ? Zend_Auth::getInstance()->getIdentity() : null;
$authRegion = $this->placeholder('tigerHeaderAuth');

// Solutions mega-menu cards: [icon, key-base, href]. Labels resolve through the translator
// (theme.mega.<name>.{title,tag,desc}) so the whole mega-menu localizes with the site.
$mega = [
    ['fa-wand-magic-sparkles', 'theme.mega.websites',   '/cms'],
    ['fa-people-group',        'theme.mega.agency',     '/agency'],
    ['fa-rocket',              'theme.mega.saas',        '/vibe'],
    ['fa-code',                'theme.mega.developers', '/developers'],
    ['fa-puzzle-piece',        'theme.mega.creators',   '/creators'],
    ['fa-server',              'theme.mega.hosting',     '/hosting'],
];
