/**
 * PUMA public header — the marketing/site navbar (MIT, Tiger-original).
 *
 * Layout: [ brand ] [ main menu ] [ · search region · ] [ utility switchers ] [ sign up ] [ sign in ]
 *
 * Two header REGIONS let a feature contribute chrome without this theme file knowing about
 * it (the two-step view renders the action script first, so a view script can fill a region
 * that the layout — and this header — read afterward):
 *   - `tigerHeaderSearch` — the centered slot; a feature drops a search trigger here
 *     (TigerDocs fills it with its ⌘K launcher). Empty on pages that don't use it.
 *   - `tigerHeaderAuth`   — the sign-up/sign-in/dashboard slot; the theme renders a sensible
 *     default (below), but a feature may override the whole region.
 *
 * Behavior (switchers, prefs) lives in tiger.prefs.js.
 */
$identity   = Zend_Auth::getInstance()->hasIdentity() ? Zend_Auth::getInstance()->getIdentity() : null;
$authRegion = $this->placeholder('tigerHeaderAuth');
?>
<nav class="navbar navbar-expand-lg border-bottom sticky-top" style="background: var(--bs-body-bg);" aria-label="<?= $this->escape($this->t('theme.a11y.primary_nav')) ?>">
    <div class="container">
        <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="/">
            <i class="fa-solid fa-paw text-primary"></i> <?= $this->escape($this->siteName ?? 'Tiger') ?>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#tigerNav"
                aria-controls="tigerNav" aria-expanded="false" aria-label="<?= $this->escape($this->t('theme.a11y.toggle_nav')) ?>">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="tigerNav">
            <ul class="navbar-nav mb-2 mb-lg-0">
                <li class="nav-item"><a class="nav-link" href="/docs"><?= $this->t('theme.nav.docs') ?></a></li>
                <li class="nav-item"><a class="nav-link" href="https://github.com/WebTigers/Tiger" target="_blank" rel="noopener"><?= $this->t('theme.nav.github') ?></a></li>
            </ul>

            <!-- Centered search region: a feature that fills `tigerHeaderSearch` (e.g. TigerDocs' ⌘K)
                 REPLACES the built-in site search, so the two never stack. Otherwise, the Tiger_Search
                 launcher shows when a provider is registered; else the slot collapses to nothing. -->
            <div class="tiger-header-search mx-lg-auto my-2 my-lg-0">
<?php $headerSearch = (string) $this->placeholder('tigerHeaderSearch'); ?>
<?php if ($headerSearch !== ''): ?>
                <?= $headerSearch ?>
<?php elseif (class_exists('Tiger_Search') && Tiger_Search::providers()): ?>
                <div class="position-relative" data-tiger-search style="min-width: 240px;">
                    <form action="/search" method="get" role="search" class="mb-0">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
                            <input type="search" name="q" class="form-control" placeholder="<?= $this->escape($this->t('theme.search.placeholder')) ?>" aria-label="<?= $this->escape($this->t('theme.search.placeholder')) ?>" autocomplete="off" data-search-input>
                        </div>
                    </form>
                    <div class="dropdown-menu w-100 shadow" style="max-height: 60vh; overflow-y: auto;" data-search-results></div>
                </div>
<?php endif; ?>
            </div>

            <div class="d-flex align-items-center gap-1">
                <?= $this->render('_partials/lang-switcher.phtml') ?>
                <?= $this->render('_partials/theme-switcher.phtml') ?>
<?php if (!empty($this->skins)): ?>
                <?= $this->render('_partials/skin-switcher.phtml') ?>
<?php endif; ?>
                <!-- Auth region: theme default (sign up / sign in, or dashboard) unless a feature fills it. -->
<?php if (count($authRegion)): ?>
                <?= $authRegion ?>
<?php elseif ($identity): ?>
                <?php
                // Route by role: an admin lands on the back office; everyone else on their own /account home
                // (so a customer is never sent to /admin, where the ACL would deny them).
                $_acl      = Zend_Registry::isRegistered('Zend_Acl') ? Zend_Registry::get('Zend_Acl') : null;
                $_role     = (is_object($identity) && !empty($identity->role)) ? $identity->role : 'guest';
                $_canAdmin = $_acl && $_acl->has('AdminController') ? $_acl->isAllowed($_role, 'AdminController') : false;
                ?>
                <a class="btn btn-primary ms-2" href="<?= $_canAdmin ? '/admin' : '/account' ?>"><i class="fa-solid fa-gauge-high me-1"></i><?= $_canAdmin ? $this->t('theme.auth.dashboard') : $this->t('theme.auth.account') ?></a>
<?php else: ?>
                <a class="btn btn-link ms-2 text-decoration-none" href="/signup"><?= $this->t('theme.auth.signup') ?></a>
                <a class="btn btn-outline-secondary" href="/login"><?= $this->t('theme.auth.signin') ?></a>
<?php endif; ?>
            </div>
        </div>
    </div>
</nav>
