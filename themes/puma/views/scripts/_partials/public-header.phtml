            <!-- Centered search region: a feature that fills `tigerHeaderSearch` (e.g. TigerDocs' ⌘K)
                 REPLACES the built-in site search, so the two never stack. Otherwise, the Tiger_Search
                 launcher shows when a provider is registered; else the slot collapses to nothing. -->
            <div class="tiger-header-search mx-lg-auto my-2 my-lg-0">
<?php $headerSearch = (string) $this->placeholder('tigerHeaderSearch'); ?>
<?php if ($headerSearch !== ''): ?>
                <?= $headerSearch ?>
<?php elseif (class_exists('Tiger_Search') && Tiger_Search::providers()): ?>
                <div class="position-relative" data-tiger-search style="min-width: 240px;">
                    <form action="/search" method="get" role="search" class="mb-0">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
                            <input type="search" name="q" class="form-control" placeholder="<?= $this->escape($this->t('theme.search.placeholder')) ?>" aria-label="<?= $this->escape($this->t('theme.search.placeholder')) ?>" autocomplete="off" data-search-input>
