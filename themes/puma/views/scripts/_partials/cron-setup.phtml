<?php
/**
 * cron-setup.phtml — the reusable "How to set up Cron" card.
 *
 * Self-contained: it reads Tiger_Schedule for the live real-cron / pseudo-cron status and builds the
 * exact cron line itself, so ANY admin screen can drop it in with zero setup —
 *   <?= $this->render('_partials/cron-setup.phtml') ?>
 * Used by the Scheduler screen and (later) the Backup screen. The visitor-driven WordPress-style
 * pseudo-cron is the fallback when no real cron is wired; this card nudges toward a real one.
 *
 * Optional var: cronCommand (string) — overrides the auto-built cron line.
 *
 * i18n: the surrounding prose is keyed (theme.cron.*), but the names of controls in cPanel's and
 * Plesk's OWN interfaces ("Add New Cron Job", "Common Settings", "Once Per Minute", "Command",
 * "Add Task", "Run a command", "Cron style", …) stay verbatim inside those strings — the user is
 * hunting for them on an English cPanel/Plesk screen, so translating them would send them looking
 * for a button that doesn't exist.
 */
$e = fn($s) => $this->escape((string) $s);

$root    = defined('APPLICATION_ROOT') ? APPLICATION_ROOT : (defined('APPLICATION_PATH') ? dirname(APPLICATION_PATH) : '/path/to/app');
$command = (string) ($this->cronCommand ?? ('php ' . $root . '/vendor/bin/tiger schedule:run >/dev/null 2>&1'));

$realCron   = class_exists('Tiger_Schedule') && Tiger_Schedule::realCronRecent();
$pseudoCron = class_exists('Tiger_Schedule') && Tiger_Schedule::pseudoCronEnabled();
?>
<div class="card">
    <div class="card-header fw-semibold">
        <i class="fa-regular fa-clock me-2"></i><?= $e($this->t('theme.cron.title')) ?>
    </div>
    <div class="card-body">

        <!-- Live status -->
        <?php if ($realCron): ?>
            <div class="alert alert-success d-flex align-items-center mb-3" role="status">
                <i class="fa-solid fa-circle-check fa-lg me-2"></i>
                <div>
                    <strong><?= $e($this->t('theme.cron.status.real.title')) ?></strong>
                    <?= $this->t('theme.cron.status.real.body') ?>
                </div>
            </div>
        <?php elseif ($pseudoCron): ?>
            <div class="alert alert-warning d-flex align-items-center mb-3" role="status">
                <i class="fa-solid fa-triangle-exclamation fa-lg me-2"></i>
                <div>
                    <strong><?= $e($this->t('theme.cron.status.pseudo.title')) ?></strong>
                    <?= $this->t('theme.cron.status.pseudo.body') ?>
                </div>
            </div>
        <?php else: ?>
            <div class="alert alert-danger d-flex align-items-center mb-3" role="status">
                <i class="fa-solid fa-circle-xmark fa-lg me-2"></i>
                <div>
                    <strong><?= $e($this->t('theme.cron.status.none.title')) ?></strong>
                    <?= $this->t('theme.cron.status.none.body') ?>
                </div>
            </div>
        <?php endif; ?>

        <!-- The command everything else pastes -->
        <label class="form-label small text-body-secondary mb-1"><?= $e($this->t('theme.cron.command_label')) ?></label>
        <div class="input-group input-group-sm mb-3">
            <input type="text" class="form-control font-monospace" id="cron-command" value="<?= $e($command) ?>" readonly>
            <button type="button" class="btn btn-outline-secondary" onclick="var i=document.getElementById('cron-command');i.select();navigator.clipboard&&navigator.clipboard.writeText(i.value);this.innerHTML='<i class=\'fa-solid fa-check\'></i>';" title="<?= $e($this->t('theme.action.copy')) ?>">
                <i class="fa-regular fa-copy"></i>
            </button>
        </div>
        <p class="small text-body-secondary"><?= $this->t('theme.cron.every_minute_note') ?></p>

        <!-- How-to tabs -->
        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item" role="presentation"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#cron-cpanel" type="button" role="tab"><i class="fa-solid fa-server me-1"></i>cPanel</button></li>
            <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#cron-plesk" type="button" role="tab"><i class="fa-solid fa-server me-1"></i>Plesk</button></li>
            <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#cron-cli" type="button" role="tab"><i class="fa-solid fa-terminal me-1"></i><?= $e($this->t('theme.cron.tab.cli')) ?></button></li>
            <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#cron-claude" type="button" role="tab"><i class="fa-solid fa-robot me-1"></i><?= $e($this->t('theme.cron.tab.claude')) ?></button></li>
        </ul>
        <div class="tab-content border border-top-0 rounded-bottom p-3">

            <div class="tab-pane fade show active" id="cron-cpanel" role="tabpanel">
                <ol class="mb-0 small">
                    <li><?= $this->t('theme.cron.cpanel.step1') ?></li>
                    <li><?= $this->t('theme.cron.cpanel.step2') ?></li>
                    <li><?= $this->t('theme.cron.cpanel.step3') ?></li>
                    <li><?= $this->t('theme.cron.cpanel.step4') ?></li>
                </ol>
                <p class="small text-body-secondary mt-2 mb-0"><?= $this->t('theme.cron.cpanel.php_path') ?></p>
            </div>

            <div class="tab-pane fade" id="cron-plesk" role="tabpanel">
                <ol class="mb-0 small">
                    <li><?= $this->t('theme.cron.plesk.step1') ?></li>
                    <li><?= $this->t('theme.cron.plesk.step2') ?></li>
                    <li><?= $this->t('theme.cron.plesk.step3') ?></li>
                    <li><?= $this->t('theme.cron.plesk.step4') ?></li>
                </ol>
            </div>

            <div class="tab-pane fade" id="cron-cli" role="tabpanel">
                <p class="small mb-2"><?= $e($this->t('theme.cron.cli.intro')) ?></p>
                <pre class="bg-body-tertiary border rounded p-2 small mb-2"><code>crontab -e</code></pre>
                <p class="small mb-2"><?= $e($this->t('theme.cron.cli.add')) ?></p>
                <pre class="bg-body-tertiary border rounded p-2 small mb-0"><code>* * * * * <?= $e($command) ?></code></pre>
            </div>

            <div class="tab-pane fade" id="cron-claude" role="tabpanel">
                <p class="small mb-2"><?= $e($this->t('theme.cron.claude.intro')) ?></p>
                <pre class="bg-body-tertiary border rounded p-2 small mb-2"><code><?= $e($this->t('theme.cron.claude.prompt')) ?>
<?= $e($command) ?></code></pre>
                <p class="small text-body-secondary mb-0"><?= $e($this->t('theme.cron.claude.note')) ?></p>
            </div>

        </div>
    </div>
</div>
