/**
 * The built-in home stub — a deliberately NEUTRAL, brandable welcome shown at "/" only when nothing
 * else claims the front door: no ComingSoon holding page, no admin-chosen home page (a CMS page or a
 * path), and no active theme `content/index.phtml`. See IndexController::indexAction for that chain.
 *
 * It carries NO product marketing (WebTigers' own marketing pages live in the private TigerMarketing
 * module, which overrides this stub by setting the home page). A fresh install shows a clean "Welcome
 * to <site name>", with a quiet next-step nudge visible only to a signed-in admin. Rendered inside the
 * PUMA public layout — semantic Bootstrap + --bs-* tokens only, so it restyles live with theme + skin.
 */
$this->title = $this->siteName ?? 'Tiger';

// Admin-only next-step nudge — the SAME identity + ACL check the public header uses (never a role-string
// compare). Anonymous visitors see only the welcome; an operator gets a link into the admin.
$identity = Zend_Auth::getInstance()->hasIdentity() ? Zend_Auth::getInstance()->getIdentity() : null;
$acl      = Zend_Registry::isRegistered('Tiger_Acl') ? Zend_Registry::get('Tiger_Acl') : null;
$role     = (is_object($identity) && !empty($identity->role)) ? $identity->role : 'guest';
$canAdmin = $acl && $acl->has('AdminController') ? $acl->isAllowed($role, 'AdminController') : false;
?>
<section class="py-5">
    <div class="container">
        <div class="text-center py-lg-5 mx-auto" style="max-width: 680px;">
            <div class="d-inline-flex align-items-center justify-content-center rounded-4 bg-primary-subtle text-primary mb-4" style="width:84px;height:84px;">
                <i class="fa-solid fa-paw" style="font-size:2.5rem;"></i>
            </div>
            <h1 class="display-5 fw-bold mb-3"><?= $this->t('core.home.welcome', $this->escape($this->siteName ?? 'Tiger')) ?></h1>
            <p class="lead text-secondary mb-0"><?= $this->escape($this->t('core.home.ready')) ?></p>

            <?php if ($canAdmin): ?>
                <div class="card border-0 shadow-sm mt-5 text-start mx-auto" style="max-width: 560px;">
                    <div class="card-body d-flex align-items-center gap-3">
                        <i class="fa-solid fa-wand-magic-sparkles fa-lg text-primary"></i>
                        <div class="flex-grow-1">
                            <p class="mb-0 text-body-secondary"><?= $this->escape($this->t('core.home.admin_hint')) ?></p>
                        </div>
                        <a href="/admin" class="btn btn-primary text-nowrap">
                            <i class="fa-solid fa-gauge-high me-1"></i><?= $this->escape($this->t('core.home.admin_cta')) ?>
                        </a>
                    </div>
                </div>
            <?php endif; ?>
        </div>
    </div>
</section>
