/**
 * Passwordless sign-in card (two steps). Step 1 emails a one-time code; step 2 verifies
 * it. Both POST over AJAX to /auth/otp (JSON). The response never reveals whether the
 * account exists, so step 1 always advances to step 2. Email channel only in this
 * version (SMS plugs in at the service layer later).
 */
?>
<div class="tiger-auth-brand">
    <span class="tiger-auth-mark"><i class="fa-solid fa-wand-magic-sparkles"></i></span>
    <h1 class="h4 mb-1"><?= $this->escape($this->t('core.auth.otp.title')) ?></h1>
    <p class="text-body-secondary small mb-0"><?= $this->escape($this->t('core.auth.otp.subtitle')) ?></p>
</div>

<div id="otp-feedback"></div>

<!-- Step 1: email -->
<form id="otp-request-form" novalidate>
    <div class="mb-3">
        <label class="form-label" for="otp-email"><?= $this->escape($this->t('core.auth.email')) ?></label>
        <input type="email" class="form-control form-control-lg" id="otp-email" name="email"
               autocomplete="username" inputmode="email" autofocus required>
    </div>
    <?php $rc = $this->formRecaptcha(); if ($rc): ?>
    <div class="mb-3 d-flex justify-content-center"><?= $rc ?></div>
    <?php endif; ?>
    <div class="d-grid">
        <button type="submit" id="otp-request-submit" class="btn btn-primary btn-lg"><?= $this->escape($this->t('core.auth.email_code')) ?></button>
    </div>
</form>

<!-- Step 2: code (revealed after step 1) -->
<form id="otp-verify-form" novalidate style="display:none;">
    <input type="hidden" name="email" id="otp-email-hidden">
    <p class="small text-body-secondary" id="otp-sent-note"></p>
    <div class="mb-3">
        <label class="form-label" for="otp-code"><?= $this->escape($this->t('core.auth.twofa.code_label')) ?></label>
        <input type="text" class="form-control form-control-lg text-center" id="otp-code" name="code"
               inputmode="numeric" autocomplete="one-time-code" maxlength="6"
               pattern="[0-9]*" placeholder="000000" style="letter-spacing:.4em;" required>
    </div>
    <div class="d-grid mb-2">
        <button type="submit" id="otp-verify-submit" class="btn btn-primary btn-lg"><?= $this->escape($this->t('core.auth.login.submit')) ?></button>
    </div>
    <div class="text-center">
        <a href="#" id="otp-restart" class="small text-decoration-none"><?= $this->escape($this->t('core.auth.otp.restart')) ?></a>
    </div>
</form>

<div class="text-center mt-3">
    <a href="/auth/login" class="small text-decoration-none"><?= $this->escape($this->t('core.auth.otp.use_password')) ?></a>
</div>

<div class="tiger-auth-foot">
    <a href="/" class="small text-decoration-none"><i class="fa-solid fa-angle-left me-1"></i><?= $this->escape($this->t('core.auth.return_to', $this->siteName ?? 'Tiger')) ?></a>
</div>

<?php
$this->i18n([
    'codeInvalid' => 'core.js.code_invalid',
    'networkError' => 'core.js.network_error',
    'recaptcha' => 'core.js.recaptcha',
]);
?>
<?php $this->pageScript('/_tiger/js/tiger.auth-otp.js', ['defer' => true]); ?>
