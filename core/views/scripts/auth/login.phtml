/**
 * Sign-in card. Renders in the 'auth' layout. Submits over AJAX to /auth/login
 * (JSON), then redirects client-side to the server-chosen target (the intended
 * destination is remembered server-side in the session, not a URL param). Auth is a
 * reserved kernel service, so login is a thin controller endpoint returning JSON.
 */
?>
<div class="tiger-auth-brand">
    <span class="tiger-auth-mark"><i class="fa-solid fa-paw"></i></span>
    <?php /* Heading stays "Tiger" on purpose — platform branding for CMS-admin installs;
             app developers override this view anyway. The Return link below uses siteName. */ ?>
    <h1 class="h4 mb-1"><?= $this->escape($this->t('core.auth.login.title')) ?></h1>
    <p class="text-body-secondary small mb-0"><?= $this->escape($this->t('core.auth.login.subtitle')) ?></p>
</div>

<?php if (!empty($this->notice)): ?>
<div class="alert alert-success py-2" role="alert"><?= $this->escape($this->notice) ?></div>
<?php endif; ?>

<div id="login-feedback"></div>

<!-- Step 1: credentials -->
<form id="login-form" novalidate>
    <div class="mb-3">
        <label class="form-label" for="login-identifier"><?= $this->escape($this->t('core.auth.login.identifier')) ?></label>
        <input type="text" class="form-control form-control-lg" id="login-identifier" name="identifier"
               autocomplete="username" autofocus required>
    </div>
    <div class="mb-2">
        <label class="form-label" for="login-password"><?= $this->escape($this->t('core.auth.password')) ?></label>
        <div class="input-group">
            <input type="password" class="form-control form-control-lg" id="login-password" name="password"
                   autocomplete="current-password" required>
            <span class="input-group-text" data-tiger-pw-toggle role="button" tabindex="-1" aria-label="<?= $this->escape($this->t('core.auth.show_password')) ?>" style="cursor:pointer;"><i class="fa-solid fa-eye"></i></span>
        </div>
    </div>
    <div class="d-flex justify-content-end mb-3">
        <a href="/auth/forgot" class="small text-decoration-none"><?= $this->escape($this->t('core.auth.login.forgot')) ?></a>
    </div>
    <?php $rc = $this->formRecaptcha(); if ($rc): ?>
    <div class="mb-3 d-flex justify-content-center"><?= $rc ?></div>
    <?php endif; ?>
    <div class="d-grid">
        <button type="submit" id="login-submit" class="btn btn-primary btn-lg"><?= $this->escape($this->t('core.auth.login.submit')) ?></button>
    </div>
</form>

<!-- Step 2: two-factor code (revealed when the account has an authenticator app) -->
<form id="twofa-form" novalidate style="display:none;">
    <p class="small text-body-secondary mb-2">
        <i class="fa-solid fa-shield-halved me-1"></i><?= $this->escape($this->t('core.auth.twofa.prompt')) ?>
    </p>
    <div class="mb-3">
        <label class="form-label" for="twofa-code"><?= $this->escape($this->t('core.auth.twofa.code_label')) ?></label>
        <input type="text" class="form-control form-control-lg text-center" id="twofa-code" name="code"
               inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]*"
               placeholder="000000" style="letter-spacing:.4em;">
    </div>
    <div class="d-grid mb-2">
        <button type="submit" id="twofa-submit" class="btn btn-primary btn-lg"><?= $this->escape($this->t('core.auth.twofa.verify')) ?></button>
    </div>
    <div class="text-center">
        <a href="#" id="twofa-recovery-toggle" class="small text-decoration-none"><?= $this->escape($this->t('core.auth.twofa.use_recovery')) ?></a>
    </div>
</form>

<div class="text-center mt-3" id="login-alt">
    <a href="/auth/otp" class="small text-decoration-none"><?= $this->escape($this->t('core.auth.login.use_code')) ?></a>
</div>

<div class="tiger-auth-foot">
    <a href="/" class="small text-decoration-none"><i class="fa-solid fa-angle-left me-1"></i><?= $this->escape($this->t('core.auth.return_to', $this->siteName ?? 'Tiger')) ?></a>
</div>

<?php
$this->i18n([
    'codeIncorrect' => 'core.js.code_incorrect',
    'invalidLogin' => 'core.js.invalid_login',
    'networkError' => 'core.js.network_error',
    'recaptcha' => 'core.js.recaptcha',
]);
?>
<?php $this->pageScript('/_tiger/js/tiger.auth-login.js', ['defer' => true]); ?>
