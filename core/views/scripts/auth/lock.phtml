/**
 * Lock card. The session stays signed in; re-verify to unlock — by password OR, for
 * passwordless (OTP) users, by a one-time code emailed to the (known) address.
 * Renders in the 'auth' layout; POSTs over AJAX to /auth/lock (JSON). Unlocking keeps
 * the same session (a re-verify, not a re-login), then returns to where the user was.
 */
$identity = $this->identity;
$email    = $this->escape($identity->email ?? '');
$who      = $this->escape(($identity && $identity->username) ? $identity->username : ($identity->email ?? ''));
?>
<div class="tiger-auth-brand">
    <span class="tiger-auth-mark"><i class="fa-solid fa-lock"></i></span>
    <h1 class="h4 mb-1"><?= $this->escape($this->t('core.auth.lock.title')) ?></h1>
    <p class="text-body-secondary small mb-0"><?= $this->escape($this->t('core.auth.lock.subtitle')) ?></p>
</div>

<div class="text-center mb-3">
    <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-secondary-subtle mb-2" style="width:56px;height:56px;">
        <i class="fa-solid fa-user fa-lg text-secondary"></i>
    </span>
    <div class="fw-semibold"><?= $who ?></div>
    <?php if ($email && $email !== $who): ?><div class="text-body-secondary small"><?= $email ?></div><?php endif; ?>
</div>

<div id="lock-feedback"></div>

<!-- Password unlock (default) -->
<div id="lock-pw-mode">
    <form id="lock-pw-form" novalidate>
        <div class="mb-3">
            <label class="form-label" for="lock-password"><?= $this->escape($this->t('core.auth.password')) ?></label>
            <div class="input-group">
                <input type="password" class="form-control form-control-lg" id="lock-password" name="password"
                       autocomplete="current-password" autofocus required>
                <span class="input-group-text" data-tiger-pw-toggle role="button" tabindex="-1" aria-label="<?= $this->escape($this->t('core.auth.show_password')) ?>" style="cursor:pointer;"><i class="fa-solid fa-eye"></i></span>
            </div>
        </div>
        <div class="d-grid mb-2">
            <button type="submit" id="lock-pw-submit" class="btn btn-primary btn-lg"><?= $this->escape($this->t('core.auth.lock.unlock')) ?></button>
        </div>
    </form>
    <div class="text-center">
        <a href="#" id="lock-use-code" class="small text-decoration-none"><?= $this->escape($this->t('core.auth.lock.use_code')) ?></a>
    </div>
</div>

<!-- Code unlock (revealed on request) -->
<?php /* The address the code goes to — read by the JS for the "code sent to X" note (no inline script). */ ?>
<div id="lock-code-mode" style="display:none;" data-email="<?= $email ?>">
    <form id="lock-send-form" novalidate>
        <p class="small text-body-secondary text-center mb-3"><?= $this->escape($this->t('core.auth.lock.email_send_to')) ?> <strong><?= $email ?></strong>.</p>
        <div class="d-grid mb-2">
            <button type="submit" id="lock-send-submit" class="btn btn-primary btn-lg"><?= $this->escape($this->t('core.auth.email_code')) ?></button>
        </div>
    </form>
    <form id="lock-code-form" novalidate style="display:none;">
        <p class="small text-body-secondary" id="lock-code-note"></p>
        <div class="mb-3">
            <label class="form-label" for="lock-code"><?= $this->escape($this->t('core.auth.twofa.code_label')) ?></label>
            <input type="text" class="form-control form-control-lg text-center" id="lock-code" name="code"
                   inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]*"
                   placeholder="000000" style="letter-spacing:.4em;" required>
        </div>
        <div class="d-grid mb-2">
            <button type="submit" id="lock-code-submit" class="btn btn-primary btn-lg"><?= $this->escape($this->t('core.auth.lock.unlock')) ?></button>
        </div>
    </form>
    <div class="text-center">
        <a href="#" id="lock-use-pw" class="small text-decoration-none"><?= $this->escape($this->t('core.auth.lock.use_password')) ?></a>
    </div>
</div>

<div class="tiger-auth-foot">
    <a href="/auth/logout" class="small text-decoration-none"><?= $this->t('core.auth.lock.not_you', $who) ?></a>
</div>

<?php
$this->i18n([
    'codeInvalid' => 'core.js.code_invalid',
    'codeSent' => 'core.js.code_sent',
    'incorrectPassword' => 'core.js.incorrect_password',
    'networkError' => 'core.js.network_error',
]);
?>
<?php $this->pageScript('/_tiger/js/tiger.auth-lock.js', ['defer' => true]); ?>
