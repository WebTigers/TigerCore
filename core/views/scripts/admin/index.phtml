/**
 * Admin dashboard — a Muuri masonry grid of module-registered widgets (Tiger_Dashboard). The shell
 * owns the card chrome (drag handle, collapse, sizing) and the layout; each widget owns only its body.
 * Up to 4 responsive columns by width; drag to rearrange and collapse state persist per-user (option
 * tier) over /api. Empty until a module registers a widget — nothing is hard-coded here.
 *
 * "Customize" (top-right) opens a modal to switch widgets on/off (WP "Screen Options" style). A hidden
 * widget renders here as a header-only shell (d-none, its body NOT rendered — no work done), kept out of
 * the Muuri grid; switching it back on fetches the body via /api (Dashboard::widgetBody) and drops the
 * card into the grid live — no page reload. The hidden set persists per-user (tiger.dashboard.prefs).
 */
$widgets = isset($this->widgets) && is_array($this->widgets) ? $this->widgets : [];
$tr = Zend_Registry::isRegistered('Zend_Translate') ? Zend_Registry::get('Zend_Translate') : null;
$t  = function ($s) use ($tr) { return $tr ? $tr->translate($s) : $s; };
// Header + empty-state copy are overridable — AccountController reuses this same grid (ACL-filtered per
// role) under an account-appropriate header, so a non-admin gets "My Account" not "Tiger admin".
$dashTitle = $this->dashTitle ?? 'core.dashboard.title';
$dashLead  = $this->dashLead ?? 'core.dashboard.lead';
?>
<header class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
    <div>
        <h1 class="h3 mb-1"><?= $this->escape($this->t($dashTitle)) ?></h1>
        <p class="text-secondary mb-0 small"><?= $this->escape($this->t($dashLead)) ?></p>
    </div>
    <?php if (!empty($widgets)): ?>
    <button type="button" class="btn btn-sm btn-outline-secondary" id="dash-customize">
        <i class="fa-solid fa-sliders me-1"></i><?= $this->escape($this->t('core.dashboard.customize')) ?>
    </button>
    <?php endif; ?>
</header>

<?php if (empty($widgets)): ?>
    <div class="text-center text-body-secondary py-5">
        <i class="fa-regular fa-window-restore fa-2x mb-3 d-block"></i>
        <p class="mb-1 fw-semibold text-body"><?= $this->escape($this->t('core.dashboard.empty_title')) ?></p>
        <p class="mb-0"><?= $this->escape($this->t($this->dashEmptyLead ?? 'core.dashboard.empty_lead')) ?></p>
    </div>
<?php else: ?>
    <div class="dash-grid" id="dash-grid">
        <?php foreach ($widgets as $w):
            $id     = htmlspecialchars($w['id'], ENT_QUOTES);
            $title  = htmlspecialchars($t($w['title']), ENT_QUOTES);
            $icon   = htmlspecialchars($w['icon'] ?: 'fa-square', ENT_QUOTES);
            $wide   = max(1, min(4, (int) ($w['width'] ?? 1)));
            $hidden = !empty($w['hidden']);
            $coll   = !$hidden && !empty($w['collapsed']);
        ?>
        <div class="dash-item<?= $hidden ? ' d-none' : '' ?>" data-id="<?= $id ?>" data-w="<?= $wide ?>"<?= (int) ($w['refresh'] ?? 0) > 0 ? ' data-refresh="' . (int) $w['refresh'] . '"' : '' ?>>
            <div class="card shadow-sm h-100">
                <div class="card-header dash-handle d-flex align-items-center gap-2" title="<?= $this->escape($this->t('core.dashboard.drag_hint')) ?>">
                    <i class="fa-solid <?= $icon ?> text-primary"></i>
                    <span class="fw-semibold flex-grow-1 text-truncate"><?= $title ?></span>
                    <button type="button" class="btn btn-sm btn-link p-0 text-body-secondary dash-collapse" aria-label="<?= $this->escape($this->t('core.dashboard.collapse_aria')) ?>">
                        <i class="fa-solid fa-chevron-<?= $coll ? 'down' : 'up' ?>"></i>
                    </button>
                </div>
                <div class="card-body dash-body"<?= $coll ? ' style="display:none"' : '' ?><?= $hidden ? ' data-lazy="1"' : '' ?>>
                    <?= $hidden ? '' : Tiger_Dashboard::renderBody($w) ?>
                </div>
            </div>
        </div>
        <?php endforeach; ?>
    </div>

    <!-- Customize: switch widgets on/off (per-user). Lists every widget the user is allowed to see. -->
    <div class="modal fade" id="dash-customize-modal" tabindex="-1" aria-hidden="true" aria-labelledby="dash-customize-title" role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="dash-customize-title"><i class="fa-solid fa-sliders me-2"></i><?= $this->escape($this->t('core.dashboard.customize_title')) ?></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<?= $this->escape($this->t('core.common.close')) ?>"></button>
                </div>
                <div class="modal-body">
                    <p class="text-body-secondary small mb-3"><?= $this->escape($this->t('core.dashboard.customize_help')) ?></p>
                    <div class="list-group" id="dash-widget-prefs"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal"><?= $this->escape($this->t('core.common.done')) ?></button>
                </div>
            </div>
        </div>
    </div>

    <?php $this->pageStyle('/_tiger/css/tiger.admin-index.css'); ?>

    <?php
$this->i18n([
    'widgetLoadError' => 'core.js.widget_load_error',
]);
?>
<?php $this->pageScript($this->themeAssets . '/vendor/muuri/muuri.min.js'); ?>
<?php $this->pageScript('/_tiger/js/tiger.admin-index.js', ['defer' => true]); ?>
<?php endif; ?>
