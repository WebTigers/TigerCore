/**
 * Contacts tab — add/edit form on top, cards below (edit/trash each). Type-aware: PHONE uses the
 * intl-tel-input widget (country dropdown + live formatting + validation) and stores E.164; Email/
 * Other use a plain input. Cards render from one JS list, so create/edit/delete just re-render; the
 * server returns the fresh list + a rotated CSRF token every save (Zend hash tokens hop-expire).
 *
 * Agent note — the phone round-trip: the widget's getNumber() → hidden `value` (E.164, e.g.
 * +15551234567) and getSelectedCountryData().iso2 → hidden `phone_country`. On edit, setNumber(E.164)
 * re-seeds the widget (it detects the country from the number). Default country = tiger.profile.phone
 * .default_country (this->phoneDefault). intl-tel-input is loaded by the layout only when
 * useIntlTel is set (Profile_IndexController sets it).
 */
// Localized strings this page's JS references — delivered via the carrier, not an inline script.
$this->i18n([
    'netError'             => 'profile.net_error',
    'contactAdd'           => 'profile.contact.add',
    'contactBadPhone'      => 'profile.contact.bad_phone',
    'contactConfirmDelete' => 'profile.contact.confirm_delete',
    'contactDeleted'       => 'profile.contact.deleted',
    'contactNone'          => 'profile.contact.none',
    'contactSaved'         => 'profile.contact.saved',
    'contactUpdate'        => 'profile.contact.update',
]);
?>
<div class="card">
    <div class="card-body">

        <form id="contact-form" onsubmit="return false;" novalidate>
            <?= $this->contactForm->getElement('_csrf') ?>
            <input type="hidden" name="link_id" id="contact-id" value="">
            <input type="hidden" name="value" id="contact-value-hidden" value="">
            <input type="hidden" name="phone_country" id="contact-phone-country" value="">
            <div class="row g-2 align-items-end">
                <div class="col-sm-3">
                    <label class="form-label" for="contact-type"><?= $this->t('profile.contact.type') ?></label>
                    <select class="form-select" id="contact-type" name="type">
                        <?php foreach ($this->contactTypes as $val => $label): ?>
                            <option value="<?= $this->escape($val) ?>"><?= $this->escape($label) ?></option>
                        <?php endforeach; ?>
                    </select>
                </div>
                <div class="col-sm-5">
                    <label class="form-label" for="contact-value"><?= $this->t('profile.contact.value') ?></label>
                    <div id="contact-value-wrap">
                        <input type="text" class="form-control" id="contact-value"
                               placeholder="<?= $this->escape($this->t('profile.contact.value_ph')) ?>">
                    </div>
                    <div id="contact-phone-wrap" class="d-none">
                        <input type="tel" class="form-control" id="contact-phone" autocomplete="tel">
                    </div>
                </div>
                <div class="col-sm-2">
                    <div class="form-check mt-4 pt-2">
                        <input class="form-check-input" type="checkbox" value="1" id="contact-primary" name="is_primary">
                        <label class="form-check-label" for="contact-primary"><?= $this->t('profile.contact.primary') ?></label>
                    </div>
                </div>
                <div class="col-sm-2">
                    <button type="button" id="contact-save" class="btn btn-primary w-100">
                        <i class="fa-solid fa-plus me-1"></i><span id="contact-save-label"><?= $this->t('profile.contact.add') ?></span>
                    </button>
                    <button type="button" id="contact-cancel" class="btn btn-link btn-sm w-100 mt-1 d-none"><?= $this->t('profile.contact.cancel') ?></button>
                </div>
            </div>
        </form>

        <hr class="my-3">
        <?php /* The contact list + the type catalog + which service answers for this context (user vs org).
         Data on attributes, logic in an asset — the view emits no <script>. */ ?>
<div id="contact-cards"
     data-contacts="<?= $this->escape(json_encode($this->contacts, JSON_UNESCAPED_UNICODE)) ?>"
     data-types="<?= $this->escape(json_encode($this->contactTypes, JSON_UNESCAPED_UNICODE)) ?>"
     data-service="<?= $this->escape($this->contactSvc ?: 'contact') ?>"
     data-phone-default="<?= $this->escape(strtolower((string) $this->phoneDefault)) ?>"></div>
    </div>
</div>

<?php $this->pageScript('/_modules/profile/js/profile.index-contacts.js', ['defer' => true]); ?>
