/**
 * Translations admin — a DataTables grid of every translation key (source + the effective value
 * for a chosen target locale), a target-locale selector + a missing/overridden filter, and an
 * edit modal with a field per locale, a per-locale AI "Translate" button, and an AI "where used"
 * context. Rows + all writes go over /api (Translations_Service_Translation). ADMIN.md house style.
 */
$default = (string) $this->default;
?>
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-1"><?= $this->t('translations.heading') ?></h1>
        <p class="text-body-secondary mb-0"><?= $this->t('translations.subtitle') ?></p>
    </div>
</div>

<div id="translations-feedback"></div>

<div class="card">
    <div class="card-body">
        <div class="row g-2 align-items-end mb-3">
            <div class="col-sm-auto">
                <label for="tr-locale" class="form-label small text-body-secondary mb-1"><?= $this->t('translations.target_locale') ?></label>
                <select id="tr-locale" class="form-select form-select-sm">
                    <?php foreach ($this->locales as $code): if ($code === $default) { continue; } ?>
                        <option value="<?= $this->escape($code) ?>"<?= $code === $this->target ? ' selected' : '' ?>>
                            <?= $this->escape($this->localeMap[$code] ?? $code) ?> (<?= $this->escape($code) ?>)
                        </option>
                    <?php endforeach; ?>
                </select>
            </div>
            <div class="col-sm-auto">
                <label for="tr-filter" class="form-label small text-body-secondary mb-1"><?= $this->t('translations.filter') ?></label>
                <select id="tr-filter" class="form-select form-select-sm">
                    <option value=""><?= $this->t('translations.filter_all') ?></option>
                    <option value="missing"><?= $this->t('translations.filter_missing') ?></option>
                    <option value="overridden"><?= $this->t('translations.filter_overridden') ?></option>
                </select>
            </div>
            <div class="col text-body-secondary small">
                <i class="fa-solid fa-circle-info me-1"></i><?= $this->t('translations.source_note', '<strong>' . $this->escape($this->localeMap[$default] ?? $default) . '</strong>') ?>
            </div>
        </div>

        <div class="table-responsive">
            <table id="translations-table" class="table table-hover align-middle" style="width:100%;">
                <thead>
                    <tr>
                        <th><?= $this->t('translations.col_key') ?></th>
                        <th><?= $this->t('translations.col_source') ?></th>
                        <th id="tr-col-target"><?= $this->t('translations.col_translation') ?></th>
                        <th class="text-center" data-orderable="false"><?= $this->t('translations.col_status') ?></th>
                        <th class="text-end" data-orderable="false"><?= $this->t('translations.col_actions') ?></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<!-- Edit modal (one reusable; fields injected per key) -->
<div class="modal fade" id="tr-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title mb-0"><?= $this->t('translations.modal_title') ?></h5>
                    <code id="tr-modal-key" class="small text-body-secondary"></code>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="tr-modal-feedback"></div>

                <!-- Agent context: where/how the key is used -->
                <div class="card bg-body-tertiary border-0 mb-3">
                    <div class="card-body py-2">
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="small fw-semibold"><i class="fa-solid fa-compass me-2"></i><?= $this->t('translations.context_heading') ?></span>
                            <button type="button" id="tr-context-btn" class="btn btn-sm btn-outline-secondary" hidden>
                                <i class="fa-solid fa-wand-magic-sparkles me-1"></i><?= $this->t('translations.explain') ?>
                            </button>
                        </div>
                        <p id="tr-context-summary" class="small mb-1 mt-2 text-body-secondary"></p>
                        <ul id="tr-context-usage" class="small text-body-secondary mb-0 ps-3"></ul>
                    </div>
                </div>

                <form id="tr-modal-form" onsubmit="return false;" novalidate>
                    <input type="hidden" id="tr-modal-keyfield">
                    <div id="tr-modal-fields"></div>
                </form>
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" id="tr-revert" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-rotate-left me-2"></i><?= $this->t('translations.revert_all') ?>
                </button>
                <div>
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal"><?= $this->t('translations.cancel') ?></button>
                    <button type="button" id="tr-save" class="btn btn-primary">
                        <i class="fa-solid fa-floppy-disk me-2"></i><?= $this->t('translations.save') ?>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    if (typeof tigerDataTable !== 'function') { return; }
    var $   = jQuery;
    var esc = tigerDataTable.esc;

    var DEFAULT_LOCALE = <?= json_encode($default) ?>;
    var L = <?= json_encode([
        'translate'   => (string) $this->t('translations.translate'),
        'translating' => (string) $this->t('translations.translating'),
        'default'     => (string) $this->t('translations.badge_default'),
        'overridden'  => (string) $this->t('translations.badge_overridden'),
        'file'        => (string) $this->t('translations.uses_file'),
        'saved'       => (string) $this->t('translations.saved_toast'),
        'reverted'    => (string) $this->t('translations.reverted_toast'),
        'noref'       => (string) $this->t('translations.no_refs'),
        'neterr'      => (string) $this->t('translations.net_error'),
        'revert_one'  => (string) $this->t('translations.revert_confirm'),
    ]) ?>;

    var modalEl = document.getElementById('tr-modal');
    var modal   = new bootstrap.Modal(modalEl);
    var current = null;   // the entry payload being edited

    function targetLocale() { return document.getElementById('tr-locale').value; }
    function currentFilter() { return document.getElementById('tr-filter').value; }

    var table = tigerDataTable('#translations-table', {
        service: { module: 'translations', service: 'translation', action: 'datatable' },
        order: [[0, 'asc']],
        extraData: function () { return { locale: targetLocale(), filter: currentFilter() }; },
        language: { search: '', searchPlaceholder: <?= json_encode((string) $this->t('translations.search_placeholder')) ?> },
        columns: [
            { data: 'key', render: function (t, type) {
                if (type !== 'display') { return t; }
                return '<code class="text-body">' + esc(t) + '</code>';
            } },
            { data: 'source', render: function (t, type) {
                if (type !== 'display') { return t; }
                return '<span class="text-body-secondary">' + esc(t) + '</span>';
            } },
            { data: 'value', render: function (t, type) {
                if (type !== 'display') { return t; }
                return t ? esc(t) : '<span class="text-warning-emphasis fst-italic">' + esc(L.file) + '</span>';
            } },
            { data: null, orderable: false, searchable: false, className: 'text-center', render: function (t, type, row) {
                if (row.overridden) { return '<span class="badge text-bg-primary">' + esc(L.overridden) + '</span>'; }
                if (row.missing)    { return '<span class="badge text-bg-warning">' + esc('!') + '</span>'; }
                return '<span class="text-body-secondary">—</span>';
            } },
            { data: null, orderable: false, searchable: false, className: 'text-end text-nowrap', render: function (t, type, row) {
                if (!row.can_edit) { return '<span class="text-body-secondary">—</span>'; }
                return '<button type="button" class="btn btn-sm btn-outline-secondary" data-edit="' + esc(row.key) + '">'
                     + '<i class="fa-solid fa-pen"></i></button>';
            } }
        ]
    });

    document.getElementById('tr-locale').addEventListener('change', function () { table.ajax.reload(); });
    document.getElementById('tr-filter').addEventListener('change', function () { table.ajax.reload(); });

    // --- open the modal for a key ---
    $('#translations-table tbody').on('click', '[data-edit]', function () {
        openEditor(this.getAttribute('data-edit'));
    });

    function openEditor(key) {
        var body = new URLSearchParams({ module: 'translations', service: 'translation', method: 'entry', key: key });
        fetch('/api', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' }, body: body })
            .then(function (r) { return r.json(); })
            .then(function (res) {
                if (!res || res.result !== 1) { return; }
                current = res.data;
                renderModal(res.data);
                modal.show();
            }).catch(function () {});
    }

    function renderModal(d) {
        document.getElementById('tr-modal-key').textContent = d.key;
        document.getElementById('tr-modal-keyfield').value = d.key;
        document.getElementById('tr-modal-feedback').innerHTML = '';

        // Fields, one per locale — default first (the source), then targets with a Translate button.
        var host = document.getElementById('tr-modal-fields');
        host.innerHTML = '';
        d.locales.forEach(function (loc) {
            var wrap = document.createElement('div');
            wrap.className = 'mb-3';
            var badge = loc.is_default
                ? '<span class="badge text-bg-secondary ms-2">' + esc(L.default) + '</span>'
                : (loc.overridden ? '<span class="badge text-bg-primary ms-2">' + esc(L.overridden) + '</span>' : '');
            var btn = loc.is_default ? '' :
                '<button type="button" class="btn btn-outline-secondary" data-tr-translate="' + esc(loc.code) + '"' + (d.ai ? '' : ' disabled title="Connect an AI provider in AI Agent settings"') + '>'
                + '<i class="fa-solid fa-language me-1"></i>' + esc(L.translate) + '</button>';
            wrap.innerHTML =
                '<label class="form-label small fw-semibold mb-1">' + esc(loc.name) + ' <span class="text-body-secondary">(' + esc(loc.code) + ')</span>' + badge + '</label>' +
                '<div class="input-group">' +
                    '<textarea class="form-control" rows="2" data-tr-value="' + esc(loc.code) + '">' + esc(loc.value) + '</textarea>' +
                    btn +
                '</div>';
            host.appendChild(wrap);
        });

        // Context: show grep usage immediately; AI summary behind the button (cached server-side).
        var summary = document.getElementById('tr-context-summary');
        var usage   = document.getElementById('tr-context-usage');
        summary.textContent = '';
        usage.innerHTML = '';
        (d.usage || []).forEach(function (u) {
            var li = document.createElement('li');
            li.innerHTML = '<code>' + esc(u.file) + ':' + u.line + '</code>';
            usage.appendChild(li);
        });
        if (!d.usage || !d.usage.length) { usage.innerHTML = '<li class="fst-italic">' + esc(L.noref) + '</li>'; }
        var ctxBtn = document.getElementById('tr-context-btn');
        ctxBtn.hidden = !d.ai;
    }

    // --- per-locale AI translate ---
    $('#tr-modal-fields').on('click', '[data-tr-translate]', function () {
        var code = this.getAttribute('data-tr-translate');
        var field = document.querySelector('[data-tr-value="' + code + '"]');
        var src = current ? current.source : '';
        var body = new URLSearchParams({ module: 'translations', service: 'translation', method: 'translate', source: src, locale: code, key: current ? current.key : '' });
        TigerButton.run(this, function () {
            return fetch('/api', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' }, body: body })
                .then(function (r) { return r.json().catch(function () { return {}; }); });
        }).then(function (res) {
            if (res && res.result === 1 && res.data && field) { field.value = res.data.text; field.focus(); }
            else { (res && res.messages || []).forEach(function (m) { TigerDOM.notify(document.getElementById('tr-modal-feedback'), m.message, { type: m.class }); }); }
        }).catch(function () {});
    });

    // --- AI context summary ---
    document.getElementById('tr-context-btn').addEventListener('click', function () {
        if (!current) { return; }
        var body = new URLSearchParams({ module: 'translations', service: 'translation', method: 'context', key: current.key });
        TigerButton.run(this, function () {
            return fetch('/api', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' }, body: body })
                .then(function (r) { return r.json().catch(function () { return {}; }); });
        }).then(function (res) {
            if (res && res.result === 1 && res.data) { document.getElementById('tr-context-summary').textContent = res.data.summary; }
        }).catch(function () {});
    });

    // --- save ---
    document.getElementById('tr-save').addEventListener('click', function () {
        if (!current) { return; }
        var fb = document.getElementById('tr-modal-feedback');
        var body = new URLSearchParams({ module: 'translations', service: 'translation', method: 'save', key: current.key });
        document.querySelectorAll('#tr-modal-fields [data-tr-value]').forEach(function (el) {
            body.append('values[' + el.getAttribute('data-tr-value') + ']', el.value);
        });
        TigerButton.run(this, function () {
            return fetch('/api', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' }, body: body })
                .then(function (r) { return r.json().catch(function () { return {}; }); });
        }).then(function (res) {
            if (res && res.result === 1) {
                modal.hide();
                TigerDOM.toast(L.saved, { type: 'success' });
                table.ajax.reload(null, false);
                return;
            }
            (res && res.messages || []).forEach(function (m) { TigerDOM.notify(fb, m.message, { type: m.class }); });
        }).catch(function () { TigerDOM.notify(fb, L.neterr, { type: 'error' }); });
    });

    // --- revert all locales for the key ---
    document.getElementById('tr-revert').addEventListener('click', function () {
        if (!current) { return; }
        var key = current.key, self = this;
        TigerModal.confirm({ title: L.revert_one, body: key, confirmLabel: L.revert_one }).then(function (ok) {
            if (!ok) { return; }
            var body = new URLSearchParams({ module: 'translations', service: 'translation', method: 'revert', key: key });
            TigerButton.run(self, function () {
                return fetch('/api', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' }, body: body })
                    .then(function (r) { return r.json().catch(function () { return {}; }); });
            }).then(function () {
                modal.hide();
                TigerDOM.toast(L.reverted, { type: 'success' });
                table.ajax.reload(null, false);
            }).catch(function () {});
        });
    });
});
</script>
