/**
 * CMS Menus list — a DataTables grid whose rows load over AJAX from the /api service
 * (Cms_Service_Menu::datatable). One row per menu (org + menu_key) with its item count.
 * The server renders only this shell; authorization (edit/delete flags) is server-side.
 */
?>
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-1">Menus</h1>
        <p class="text-body-secondary mb-0">Custom navigation menus — reusable by any theme via <code>&lt;?= $this-&gt;menu('key') ?&gt;</code>, the <code>[menu]</code> shortcode, or <code>Tiger_Menu::getHTML()</code>.</p>
    </div>
    <a href="/cms/menu/edit" class="btn btn-primary"><i class="fa-solid fa-plus me-2"></i>New Menu</a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="cms-menus-table" class="table table-hover align-middle" style="width:100%;">
                <thead>
                    <tr>
                        <th>Menu</th>
                        <th>Type</th>
                        <th>Source</th>
                        <th>Items</th>
                        <th>Updated</th>
                        <th class="text-end" data-orderable="false">Actions</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    if (typeof tigerDataTable !== 'function') { return; }
    var $   = jQuery;
    var esc = tigerDataTable.esc;

    var table = tigerDataTable('#cms-menus-table', {
        service: { module: 'cms', service: 'menu', action: 'datatable' },
        order: [[0, 'asc']],
        language: { search: '', searchPlaceholder: 'Search menus…' },
        columns: [
            { data: 'menu_key', render: function (t, type, row) {
                if (type !== 'display') { return t; }
                var org = (row.scope === 'Org') ? ' <span class="badge text-bg-info">Org</span>' : '';
                return '<a href="/cms/menu/edit/key/' + encodeURIComponent(t) + '" class="fw-semibold text-decoration-none">'
                    + '<i class="fa-solid fa-bars fa-fw text-body-secondary me-1"></i>' + esc(t) + '</a>' + org;
            } },
            { data: 'type', render: function (t, type) {
                if (type !== 'display') { return t; }
                var m = (t === 'theme') ? ['secondary', 'Theme'] : ['primary', 'Custom'];
                return '<span class="badge text-bg-' + m[0] + '">' + esc(m[1]) + '</span>';
            } },
            { data: 'source_name', render: function (t, type) {
                if (type !== 'display') { return t; }
                return t ? '<span class="text-body-secondary"><i class="fa-solid fa-palette fa-fw me-1"></i>' + esc(t) + '</span>'
                         : '<span class="text-body-secondary">—</span>';
            } },
            { data: 'items', className: 'text-center' },
            { data: 'updated', render: function (t, type) { return (type === 'display' && !t) ? '<span class="text-body-secondary">—</span>' : t; } },
            { data: null, orderable: false, searchable: false, className: 'text-end text-nowrap', render: function (t, type, row) {
                var html = '';
                if (row.can_edit) {
                    var title = row.type === 'theme' ? 'Edit (customize)' : 'Edit';
                    html += '<a href="/cms/menu/edit/key/' + encodeURIComponent(row.menu_key) + '" class="btn btn-sm btn-outline-secondary" title="' + title + '" aria-label="' + title + '"><i class="fa-solid fa-pen"></i></a> ';
                }
                if (row.can_revert) {
                    html += '<button type="button" class="btn btn-sm btn-outline-secondary" data-menu-revert="' + esc(row.menu_key) + '" data-org="' + esc(row.org_id) + '" title="Revert to theme" aria-label="Revert to theme"><i class="fa-solid fa-rotate-left"></i></button> ';
                }
                if (row.can_delete) {
                    html += '<button type="button" class="btn btn-sm btn-outline-danger" data-menu-delete="' + esc(row.menu_key) + '" data-org="' + esc(row.org_id) + '" title="Delete menu" aria-label="Delete menu"><i class="fa-solid fa-trash"></i></button>';
                }
                return html || '<span class="text-body-secondary">—</span>';
            } }
        ]
    });

    function menuAction(btn, method, key, org, confirmOpts) {
        TigerModal.confirm(confirmOpts).then(function (ok) {
            if (!ok) { return; }
            var body = new URLSearchParams({ module: 'cms', service: 'menu', method: method, menu_key: key, org_id: org || '' });
            TigerButton.run(btn, function () {
                return fetch('/api', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' }, body: body })
                    .then(function (r) { return r.json().catch(function () { return {}; }); });
            }).then(function () { table.ajax.reload(null, false); })
              .catch(function () { table.ajax.reload(null, false); });
        });
    }
    $('#cms-menus-table tbody').on('click', '[data-menu-delete]', function () {
        var key = this.getAttribute('data-menu-delete');
        menuAction(this, 'deleteMenu', key, this.getAttribute('data-org'),
            { title: 'Delete menu', body: 'Delete the entire "' + key + '" menu and all its items?', confirmLabel: 'Delete', variant: 'danger' });
    });
    $('#cms-menus-table tbody').on('click', '[data-menu-revert]', function () {
        var key = this.getAttribute('data-menu-revert');
        menuAction(this, 'revertToTheme', key, this.getAttribute('data-org'),
            { title: 'Revert to theme', body: 'Discard your changes to "' + key + '" and restore the theme menu?', confirmLabel: 'Revert' });
    });
});
</script>
