/**
 * CMS visual builder — a full-screen GrapesJS surface for ONE page. The admin layout is
 * disabled (controller), so this is a complete document that owns the viewport. Page
 * metadata (title/slug/status) is edited in the normal page editor; here the author
 * designs the body visually. Save posts to /api (Cms_Service_Page::saveDesign) and the
 * canvas restores losslessly from meta.builder.
 */
$va = $this->themeAssets;
// Safe JSON embedding in a <script> context (no </script> or quote breakouts).
$jf = JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP;

// The base front-end stylesheets the LIVE page uses. GrapesJS renders the page inside an isolated
// iframe that does NOT inherit the outer document's <link>s, so these must be injected into the
// canvas (below) — otherwise the page edits as unstyled HTML. Same set + order as the public layout.
$canvasStyles = [
    $this->asset($va . '/vendor/fonts/inter/inter.css'),
    $this->asset($va . '/vendor/fontawesome/css/all.min.css'),
    $this->asset($va . '/css/bootstrap.css'),
    $this->asset($va . '/default.css'),
];
if (!empty($this->skin)) { $canvasStyles[] = $this->asset($va . '/skins/' . $this->skin . '.css'); }
$canvasStyles[] = $this->asset($va . '/custom.css');

// The LOCKED chrome around the editable region (Elementor-style theme context). Two sources:
//   • a PARTIAL edited against a CMS layout supplies its own split chrome (controller: chromeBefore/
//     chromeAfter, cut at the partial's slot) — so a header partial edits at the top with the footer
//     below as context, a hero edits in the content area between real header + footer;
//   • everything else (a page, or a partial with no CMS layout) uses the theme's real public
//     header + footer.
// <style>/<script> are stripped — it's a static preview, kept out of the saved body.
$tbStrip = ['#<style\b[^>]*>.*?</style>#is', '#<script\b[^>]*>.*?</script>#is'];
$headerHtml = '';
$footerHtml = '';
if ($this->chromeBefore !== null || $this->chromeAfter !== null) {
    $headerHtml = (string) $this->chromeBefore;   // already style/script-stripped by the controller
    $footerHtml = (string) $this->chromeAfter;
} else {
    // A content-scoped active theme keeps the base theme's GLOBAL chrome, so its own header/footer
    // partials aren't in the view path here. Add the active theme's views (builder render only, highest
    // priority) so a page previews in the ACTIVE theme's real header/footer — with its own menu — instead
    // of falling back to the base theme's public chrome. A theme without these partials still falls back.
    if (class_exists('Tiger_Theme')) {
        $themeViews = rtrim((string) Tiger_Theme::dir(), '/') . '/views/scripts';
        if ($themeViews !== '/views/scripts' && is_dir($themeViews)) { $this->addScriptPath($themeViews); }
    }
    try { $headerHtml = trim((string) preg_replace($tbStrip, '', (string) $this->render('_partials/public-header.phtml'))); } catch (\Throwable $e) {}
    try { $footerHtml = trim((string) preg_replace($tbStrip, '', (string) $this->render('_partials/public-footer.phtml'))); } catch (\Throwable $e) {}
}
?>
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><?= $this->escape($this->title ?: 'Untitled') ?> — Builder</title>

    <script src="<?= $this->asset($va . '/js/theme-init.js') ?>"></script>
    <link rel="stylesheet" href="<?= $this->asset($va . '/vendor/fonts/inter/inter.css') ?>">
    <link rel="stylesheet" href="<?= $this->asset($va . '/vendor/fontawesome/css/all.min.css') ?>">
    <link rel="stylesheet" href="<?= $this->asset($va . '/css/bootstrap.css') ?>">
    <link rel="stylesheet" href="<?= $this->asset($va . '/default.css') ?>">
<?php if (!empty($this->skin)): ?>
    <link rel="stylesheet" href="<?= $this->asset($va . '/skins/' . $this->skin . '.css') ?>">
<?php endif; ?>
    <link rel="stylesheet" href="<?= $this->asset($va . '/vendor/grapesjs/grapes.min.css') ?>">
    <link rel="stylesheet" href="<?= $this->asset($va . '/builder.css') ?>">
</head>
<body>
    <header class="tb-bar">
        <div class="tb-left">
            <span class="tb-brand"><i class="fa-solid fa-panorama me-1"></i>Tiger Builder</span>
<?php if (!empty($this->partialMode)): ?>
            <span class="badge text-bg-secondary-subtle text-secondary-emphasis"><i class="fa-solid <?= ($this->fragmentLabel === 'Block' ? 'fa-cube' : 'fa-puzzle-piece') ?> me-1"></i><?= $this->escape($this->fragmentLabel ?: 'Partial') ?></span>
<?php endif; ?>
            <span class="tb-title"><?= $this->escape($this->title ?: 'Untitled') ?></span>
        </div>
        <div class="tb-right">
            <span id="tb-status" class="tb-status"></span>
<?php if (!empty($this->partialMode) && !empty($this->layoutOptions)): ?>
            <label class="tb-layout-wrap d-inline-flex align-items-center gap-1" title="Preview this partial inside a layout's chrome">
                <i class="fa-solid fa-table-columns text-body-secondary"></i>
                <select id="tb-layout" class="form-select form-select-sm" style="width:auto;">
                    <option value="">Theme default</option>
<?php foreach ($this->layoutOptions as $lk => $ll): ?>
                    <option value="<?= $this->escape($lk) ?>"<?= ($lk === $this->partialLayoutKey ? ' selected' : '') ?>><?= $this->escape($ll) ?></option>
<?php endforeach; ?>
                </select>
            </label>
<?php endif; ?>
            <button id="tb-save-block" class="btn btn-sm btn-outline-secondary" type="button" title="Save the selected element as a reusable Block"><i class="fa-solid fa-cube me-1"></i>Save as Block</button>
            <button id="tb-theme" class="btn btn-sm btn-outline-secondary" type="button" title="Toggle canvas light / dark"><i class="fa-solid fa-sun"></i></button>
            <a class="btn btn-sm btn-outline-secondary" href="/cms/page/edit/id/<?= $this->escape($this->page->page_id) ?>"><i class="fa-solid fa-gear me-1"></i>Settings</a>
            <a class="btn btn-sm btn-outline-secondary" href="/cms/page"><i class="fa-solid fa-xmark me-1"></i>Exit</a>
            <button id="tb-save" class="btn btn-sm btn-primary" type="button"><i class="fa-solid fa-floppy-disk me-1"></i>Save</button>
        </div>
    </header>

    <div id="gjs"></div>

    <script>
        window.TIGER_BUILDER = {
            pageId:   <?= json_encode((string) $this->page->page_id, $jf) ?>,
            api:      '/api',
            project:  <?= $this->projectData ? json_encode($this->projectData, $jf) : 'null' ?>,
            seedHtml: <?= json_encode((string) $this->page->body, $jf) ?>,
            menus:    <?= json_encode($this->menus ?: (object) [], $jf) ?>,
            partials: <?= json_encode($this->partials ?: (object) [], $jf) ?>,
            userBlocks:   <?= json_encode($this->userBlocks ?: [], $jf) ?>,
            themeBlocks:  <?= json_encode($this->themeBlocks ?: [], $jf) ?>,
            headerHtml:   <?= json_encode($headerHtml, $jf) ?>,
            footerHtml:   <?= json_encode($footerHtml, $jf) ?>,
            partialMode:  <?= !empty($this->partialMode) ? 'true' : 'false' ?>,
            canvasStyles: <?= json_encode($canvasStyles, $jf) ?>,
            canvasCss:    <?= json_encode($this->canvasCss ?: [], $jf) ?>
        };
    </script>
    <script src="<?= $this->asset($va . '/js/bootstrap.bundle.js') ?>"></script>
    <script src="<?= $this->asset($va . '/js/tiger.media-picker.js') ?>"></script>
    <script src="<?= $this->asset($va . '/vendor/grapesjs/grapes.min.js') ?>"></script>
    <script src="<?= $this->asset($va . '/vendor/grapesjs/grapesjs-preset-webpage.js') ?>"></script>
<?php if (!empty($this->builderJs)): ?>
    <!-- Active theme's own builder components (registers window.TigerThemeBuilder) — MUST load before
         the builder so its component types exist when the page HTML is parsed. -->
    <script src="<?= $this->escape($this->builderJs) ?>"></script>
<?php endif; ?>
    <script src="<?= $this->asset($va . '/js/tiger.page-builder.js') ?>"></script>
</body>
</html>
