<?php
/**
 * Updates screen — WordPress Dashboard → Updates parity: everything stale in one list, checkboxes,
 * Update / Update All, and a live step log. Applies over /api (System_Service_Updates); the
 * controller only renders the detected list. Semantic Bootstrap only. See ADMIN.md.
 */
$updates = $this->updates ?? [];
$pending = $this->pending ?? [];
?>
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-1"><?= $this->t('system.updates.title') ?></h1>
        <p class="text-body-secondary mb-0"><?= $this->t('system.updates.subtitle') ?></p>
    </div>
    <div class="text-nowrap">
        <button type="button" id="updates-refresh" class="btn btn-outline-secondary">
            <i class="fa-solid fa-rotate me-2"></i><?= $this->t('system.updates.check_again') ?>
        </button>
        <?php if ($pending): ?>
            <button type="button" id="updates-all" class="btn btn-primary">
                <i class="fa-solid fa-cloud-arrow-down me-2"></i><?= $this->t('system.updates.update_all') ?>
            </button>
        <?php endif; ?>
    </div>
</div>

<div id="updates-feedback"></div>

<?php // Always rendered: hidden while anything is pending, revealed by the JS when the last one completes. ?>
<div class="card border-0 shadow-sm<?= $pending ? ' d-none' : '' ?>" id="updates-uptodate">
    <div class="card-body text-center p-5">
        <i class="fa-solid fa-circle-check text-success fs-1 mb-3"></i>
        <h2 class="h5"><?= $this->t('system.updates.uptodate_title') ?></h2>
        <p class="text-body-secondary mb-0"><?= $this->t('system.updates.uptodate_body') ?></p>
    </div>
</div>
<?php if ($pending): ?>
    <div class="card border-0 shadow-sm" id="updates-pending">
        <div class="card-header d-flex align-items-center gap-2">
            <input type="checkbox" id="updates-select-all" class="form-check-input mt-0" checked
                   aria-label="<?= $this->escape($this->t('system.updates.select_all')) ?>">
            <span class="fw-semibold"><?= $this->escape($this->t(count($pending) === 1 ? 'system.updates.available_one' : 'system.updates.available_many', count($pending))) ?></span>
        </div>
        <ul class="list-group list-group-flush" id="updates-list">
            <?php foreach ($pending as $u): ?>
                <li class="list-group-item d-flex align-items-center gap-3"
                    data-slug="<?= $this->escape($u['slug']) ?>" data-type="<?= $this->escape($u['type']) ?>">
                    <span class="update-mark d-inline-flex align-items-center justify-content-center">
                        <input type="checkbox" class="form-check-input mt-0 update-check" checked
                               aria-label="<?= $this->escape($this->t('system.updates.update_aria', $u['name'])) ?>">
                    </span>
                    <?php $icon = $u['type'] === 'core' ? 'fa-cube text-primary' : ($u['type'] === 'skill' ? 'fa-graduation-cap text-body-secondary' : 'fa-puzzle-piece text-body-secondary'); ?>
                    <i class="fa-solid fa-fw <?= $icon ?>"></i>
                    <div class="flex-grow-1">
                        <div class="fw-semibold">
                            <?= $this->escape($u['name']) ?>
                            <?php if ($u['type'] === 'core'): ?>
                                <span class="badge text-bg-light border ms-1"><?= $this->t('system.updates.badge_platform') ?></span>
                            <?php elseif ($u['type'] === 'skill'): ?>
                                <span class="badge text-bg-light border ms-1"><?= $this->t('system.updates.badge_skill') ?></span>
                            <?php endif; ?>
                        </div>
                        <div class="small text-body-secondary">
                            <span class="font-monospace update-installed"><?= $this->escape($u['installed']) ?></span>
                            <i class="fa-solid fa-arrow-right-long mx-1 update-arrow"></i>
                            <span class="font-monospace fw-semibold text-success update-latest"><?= $this->escape($u['latest']) ?></span>
                            <?php if ($u['type'] === 'core' && $u['method'] !== 'installer'): ?>
                                <span class="badge text-bg-warning ms-2"><?= $this->t('system.updates.badge_manual') ?></span>
                            <?php endif; ?>
                        </div>
                        <?php if (!empty($u['notes'])): $nid = 'notes-' . preg_replace('/[^a-z0-9]+/i', '-', $u['slug']); ?>
                            <button type="button" class="btn btn-link btn-sm p-0 mt-1 text-decoration-none small"
                                    data-bs-toggle="collapse" data-bs-target="#<?= $nid ?>"
                                    aria-expanded="false" aria-controls="<?= $nid ?>">
                                <i class="fa-solid fa-scroll me-1"></i><?= $this->escape($this->t('system.updates.whats_new', $u['latest'])) ?>
                            </button>
                            <div class="collapse" id="<?= $nid ?>">
                                <pre class="small text-body-secondary bg-body-tertiary rounded p-3 mt-2 mb-0 updates-notes"><?= $this->escape($u['notes']) ?></pre>
                            </div>
                        <?php endif; ?>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-primary update-one">
                        <i class="fa-solid fa-cloud-arrow-down me-1"></i><?= $this->t('system.updates.update') ?>
                    </button>
                    <span class="update-status small"></span>
                </li>
            <?php endforeach; ?>
        </ul>
    </div>
<?php endif; ?>

<div id="updates-log-card" class="card border-0 shadow-sm mt-4 d-none">
    <div class="card-header fw-semibold"><i class="fa-solid fa-list-check me-2"></i><?= $this->t('system.updates.log') ?></div>
    <div class="card-body">
        <pre id="updates-log" class="mb-0 small overflow-auto updates-log"></pre>
    </div>
</div>

<?php if (!empty($this->history)): ?>
<div class="card border-0 shadow-sm mt-4">
    <div class="card-header fw-semibold"><i class="fa-solid fa-clock-rotate-left me-2"></i><?= $this->t('system.updates.history') ?></div>
    <div class="table-responsive">
        <table class="table table-sm mb-0 align-middle">
            <thead>
                <tr class="text-body-secondary small">
                    <th class="ps-3"><?= $this->t('system.updates.col_when') ?></th><th><?= $this->t('system.updates.col_item') ?></th><th><?= $this->t('system.updates.col_kind') ?></th><th><?= $this->t('system.updates.col_version') ?></th><th><?= $this->t('system.updates.col_outcome') ?></th><th></th>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($this->history as $i => $h):
                    $badge = ['success' => 'text-bg-success', 'failed' => 'text-bg-danger',
                              'rolled_back' => 'text-bg-warning', 'advisory' => 'text-bg-secondary'][$h['outcome']] ?? 'text-bg-light';
                ?>
                    <tr>
                        <td class="ps-3 small text-body-secondary text-nowrap"><?= $this->escape($h['created_at']) ?></td>
                        <?php
                        $hicon = $h['item_type'] === 'core' ? 'fa-cube' : ($h['item_type'] === 'skill' ? 'fa-graduation-cap' : 'fa-puzzle-piece');
                        $hkind = ['core' => 'system.updates.badge_platform', 'skill' => 'system.updates.badge_skill'][$h['item_type']] ?? 'system.updates.badge_module';
                        ?>
                        <td>
                            <i class="fa-solid fa-fw me-1 text-body-secondary <?= $hicon ?>"></i>
                            <?= $this->escape($h['item_name'] ?: $h['item_slug']) ?>
                        </td>
                        <td><span class="badge text-bg-light border"><?= $this->t($hkind) ?></span></td>
                        <td class="small font-monospace text-body-secondary"><?= $this->escape($h['from_version']) ?> → <?= $this->escape($h['to_version']) ?></td>
                        <td><span class="badge <?= $badge ?>"><?= $this->escape($h['outcome']) ?></span></td>
                        <td class="pe-3 text-end">
                            <?php if (!empty($h['log'])): ?>
                                <button class="btn btn-sm btn-link p-0" type="button" data-bs-toggle="collapse" data-bs-target="#uh-<?= (int) $i ?>"><?= $this->t('system.updates.log_link') ?></button>
                            <?php endif; ?>
                        </td>
                    </tr>
                    <?php if (!empty($h['log'])): ?>
                        <tr class="collapse" id="uh-<?= (int) $i ?>">
                            <td colspan="6" class="ps-3 pe-3">
                                <pre class="small mb-2 bg-body-tertiary rounded p-2 updates-prewrap"><?php
                                    foreach ($h['log'] as $s) {
                                        echo (!empty($s['ok']) ? '· ' : '✗ ') . '[' . $this->escape($s['step']) . '] ' . $this->escape($s['detail']) . "\n";
                                    }
                                ?></pre>
                            </td>
                        </tr>
                    <?php endif; ?>
                <?php endforeach; ?>
            </tbody>
        </table>
    </div>
</div>
<?php endif; ?>

<?php
$this->i18n([
    'networkError'      => 'system.js.network_error',
    'networkErrorShort' => 'system.js.network_error_short',
    'selectUpdate'      => 'system.js.select_update',
    'updatesApplied'    => 'system.js.updates_applied',
    'updatesAttention'  => 'system.js.updates_attention',
    'stateDone'         => 'system.updates.state_done',
    'stateFailed'       => 'system.updates.state_failed',
    'stateManual'       => 'system.updates.state_manual',
    'stateCurrent'      => 'system.updates.state_current',
]);
?>
