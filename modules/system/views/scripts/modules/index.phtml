<ul class="nav nav-pills mb-3" id="mods-type-filter" role="tablist">
    <li class="nav-item"><a class="nav-link<?= $activeType === '' ? ' active' : '' ?>" href="#" data-type="" role="tab"><?= $this->t('system.modules.filter_all') ?> <span class="badge rounded-pill text-bg-light ms-1"><?= $total ?></span></a></li>
<?php foreach ($typePills as $id => $label): ?>
    <li class="nav-item"><a class="nav-link<?= $activeType === (string) $id ? ' active' : '' ?>" href="#" data-type="<?= $this->escape($id) ?>" role="tab"><i class="fa-solid <?= $typeIcon($id) ?> me-1"></i><?= $this->escape($label) ?> <span class="badge rounded-pill text-bg-light ms-1"><?= (int) ($counts[$id] ?? 0) ?></span></a></li>
<?php endforeach; ?>
</ul>

