/**
 * Modules admin — the installed-modules list (the WordPress "Plugins" screen for Tiger).
 *
 * Client/server paradigm (WEBSERVICES §5): the view ships an EMPTY table + the TYPE-filter pills and
 * fetches rows from System_Service_Modules::datatable over /api — rows are never server-rendered.
 * Server-side search / type-filter / sort / paginate; the client's column renderers build the cells
 * and gate the activate / deactivate / delete controls off per-row ACL flags. The active pill is
 * chosen server-side from a cookie so the first load is already filtered (no All → tab flash), and an
 * activate / delete re-fetches the grid in place (table.ajax.reload) instead of reloading the page.
 */
$typeLabels = $this->typeLabels ?? [];            // {type_id: label} from the registry taxonomy (may be empty offline)
$counts     = $this->counts ?? [];                // {type_id: count} over the whole catalog
$total      = (int) ($this->total ?? 0);
$activeType = (string) ($this->activeType ?? ''); // the remembered pill (cookie), '' = All
$humanize   = static function ($id) { return ucwords(str_replace(['-', '_'], ' ', (string) $id)); };
$typeIcon   = static function ($t) {
    switch ($t) {
        case 'theme':  return 'fa-palette';
        case 'code':   return 'fa-code';
        case 'app':    return 'fa-cubes';
        case 'plugin': return 'fa-plug';
        default:       return 'fa-cube';
    }
};

// Type pills: All + one per type PRESENT among installed modules, ordered by the taxonomy (then any
// leftover present types), each with a count. Pills filter the grid server-side by the module's type id.
$typePills = [];   // [id => label]
foreach ($typeLabels as $id => $label) { if (isset($counts[$id])) { $typePills[$id] = $label; } }
foreach (array_keys($counts) as $id) { if (!isset($typePills[$id])) { $typePills[$id] = $humanize($id); } }

// Carry the localized strings this page's JS references (via tiger.i18n.js — never inline).
$this->i18n([
    'confirmActivate'  => 'system.js.confirm_activate',
    'deleteFailed'     => 'system.js.delete_failed',
    'deleteUnavailable' => 'system.js.delete_unavailable',
    'networkError'     => 'system.js.network_error',
    'activateTitle'    => 'system.js.activate_title',
    'activateOk'       => 'system.js.activate_ok',
    'deactivateTitle'  => 'system.js.deactivate_title',
    'deactivateOk'     => 'system.js.deactivate_ok',
    'deactivateRequired' => 'system.js.deactivate_required',
    'deactivateTheme'  => 'system.js.deactivate_theme',
    'deactivateConfirm' => 'system.js.deactivate_confirm',
    'activateThemeTitle' => 'system.js.activate_theme_title',
    'activateThemeBody' => 'system.js.activate_theme_body',
    'activateThemeMakeDefault' => 'system.js.activate_theme_make_default',
    // Row display labels (badges + action buttons), rendered client-side off the row's data.
    'statusActive'     => 'system.modules.status_active',
    'statusInactive'   => 'system.modules.status_inactive',
    'sourceBundled'    => 'system.modules.source_bundled',
    'sourceAddon'      => 'system.modules.source_addon',
    'activate'         => 'system.modules.activate',
    'deactivate'       => 'system.modules.deactivate',
    'autoUpdateTitle'  => 'system.modules.autoupdate_title',
    'autoUpdateAria'   => 'system.modules.autoupdate_aria',
    'autoUpdateOn'     => 'system.modules.autoupdate_on',
    'autoUpdateOff'    => 'system.modules.autoupdate_off',
    'alwaysOn'         => 'system.modules.always_on',
    'defaultTheme'     => 'system.modules.default_theme',
    'defaultThemeTitle' => 'system.modules.default_theme_title',
    'protectedTitle'   => 'system.modules.protected_title',
    'deleteTitle'      => 'system.modules.delete_title',
]);
?>

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-1"><?= $this->t('system.modules.title') ?></h1>
        <p class="text-body-secondary mb-0"><?= $this->t('system.modules.subtitle') ?></p>
