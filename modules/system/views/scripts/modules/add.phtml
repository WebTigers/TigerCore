<script src="<?= $this->asset($this->themeAssets . '/vendor/tiger-lightbox/tiger-lightbox.js') ?>"></script>
<script src="<?= $this->asset($this->themeAssets . '/vendor/muuri/muuri.min.js') ?>"></script>
<script src="<?= $this->asset($this->themeAssets . '/vendor/tiger-upload/tiger-upload.js') ?>"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    var PASS_CHECKOUT = <?= json_encode($passCheckout) ?>;
    var fb = document.getElementById('mod-feedback');
    var urlEl = document.getElementById('mod-url'), refEl = document.getElementById('mod-ref');
    var modalEl = document.getElementById('mod-detail');
    var modal = new bootstrap.Modal(modalEl);
    var head = document.getElementById('mod-detail-head'), body = document.getElementById('mod-detail-body'), foot = document.getElementById('mod-detail-foot');

    // Install state + the per-user nag preference — set from every search payload (and the TigerPASS tab).
    var passHas = false, nagShow = true, nagDisabled = false;

    function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];}); }
    function badge(t,cls){ return '<span class="badge text-bg-'+cls+' me-1">'+esc(t)+'</span>'; }
    function api(method,data){ var b=new URLSearchParams(Object.assign({module:'system',service:'modules',method:method},data)); return fetch('/api',{method:'POST',headers:{'X-Requested-With':'XMLHttpRequest'},body:b}).then(function(r){return r.json();}); }
    var imgErr = "this.style.display='none'";

    // ---------- the detail modal (unchanged review-before-install path) ----------
    function openDetail(repo, ref, extra, btn){
        extra = extra || {};
        head.innerHTML = '<h5 class="modal-title mb-0">Loading…</h5>';
        body.innerHTML = '<div class="text-center py-5"><span class="spinner-border"></span></div>';
        foot.innerHTML = '';
        modal.show();
        var task = function(){ return api('inspect', { url: repo, ref: ref || '' }); };
        (btn ? TigerButton.run(btn, task) : task()).then(function(res){
            if (res.result !== 1){ body.innerHTML = ''; (res.messages||[]).forEach(function(m){ TigerDOM.notify(body, m.message, { type: m.class, replace: false }); }); return; }
            renderDetail(Object.assign({}, res.data, { _extra: extra }));
        }).catch(function(){ TigerDOM.notify(body, 'Network error.', { type: 'error' }); });
    }

    function renderDetail(d){
        var m = d.manifest, x = d._extra || {}, req = m.requires || {};
        var logo = x.logo || '';
        var vendor = x.vendor || m.author || '';
        head.innerHTML =
            (logo ? '<img src="'+esc(logo)+'" alt="" class="mod-logo" onerror="'+imgErr+'">' : '') +
            '<div><h5 class="modal-title mb-0">'+esc(m.name)+' '+(m.version?'<span class="text-body-secondary fs-6">v'+esc(m.version)+'</span>':'')+'</h5>'+
            '<div class="small text-body-secondary">'+(vendor?esc(vendor)+' · ':'')+'<code>/'+esc(m.slug)+'</code></div></div>';

        var reqBits=[]; if(req.tiger)reqBits.push('Tiger '+esc(req.tiger)); if(req.php)reqBits.push('PHP '+esc(req.php));
        var avail = x.availability || '';
        var pricing = (x.pricing && x.pricing.model) || m.pricing;
        var media = [];
        if (x.video && x.video.src){ media.push({ type: x.video.type || 'video', src: x.video.src, poster: x.video.poster || '' }); }
        (Array.isArray(x.screenshots) ? x.screenshots : []).forEach(function(s){ media.push({ type:'image', src:s }); });
        var gallery = media.length ? '<div class="mod-shots d-flex flex-wrap gap-2">' +
            media.map(function(it,i){
                if (it.type === 'video' || it.type === 'iframe'){
                    return '<span class="mod-shot-vid" data-media="'+i+'" title="Play video">' +
                        (it.poster ? '<img src="'+esc(it.poster)+'" alt="" onerror="'+imgErr+'">' : '') +
                        '<i class="fa-solid fa-circle-play"></i></span>';
                }
                return '<img src="'+esc(it.src)+'" class="mod-shot" data-media="'+i+'" loading="lazy" alt="screenshot '+(i+1)+'" onerror="'+imgErr+'">';
            }).join('') +
            '</div>' : '';
        body.innerHTML =
            (x.hero ? '<img src="'+esc(x.hero)+'" alt="" class="mod-hero" onerror="'+imgErr+'">' : '') +
            gallery +
            '<div class="mb-2">' +
              availBadgeHTML(avail || (pricing==='free'?'free':(pricing==='freemium'?'freemium':(pricing==='licensed'?'pass':'')))) +
              '<a href="'+esc(d.repo)+'" target="_blank" rel="noopener" class="badge text-bg-light text-decoration-none"><i class="fa-brands fa-github me-1"></i>'+esc(d.repo.replace('https://github.com/',''))+'@'+esc(d.ref)+'</a>' +
              (reqBits.length?' <span class="small text-body-secondary ms-1">Requires '+reqBits.join(', ')+'</span>':'') +
            '</div>' +
            ((m.compat && !m.compat.ok && m.compat.message) ? '<div class="alert alert-warning py-2 px-3 small mb-2"><i class="fa-solid fa-triangle-exclamation me-1"></i>'+esc(m.compat.message)+'</div>' : '') +
            (m.description ? '<p>'+esc(m.description)+'</p>' : '') +
            (d.description_html ? '<hr><div class="mod-readme">'+d.description_html+'</div>' : '<p class="text-body-secondary small">No TIGER.md provided.</p>');

        body.querySelectorAll('[data-media]').forEach(function(el){
            el.addEventListener('click', function(){
                if (window.TigerLightbox){ TigerLightbox.open(media.map(function(it){ return { type: it.type, src: it.src }; }), +el.getAttribute('data-media')); }
            });
        });

        // Footer: a PASS-covered module you don't yet own → route to the subscription, not a dead Install.
        if (d.installed){
            foot.innerHTML = '<span class="text-success"><i class="fa-solid fa-circle-check me-1"></i>Installed'+(d.installed_version?' (v'+esc(d.installed_version)+')':'')+'</span>';
        } else if (avail === 'pass' && !passHas){
            foot.innerHTML = '<button type="button" class="btn btn-warning" id="mod-getpass"><i class="fa-solid fa-paw me-1"></i>Get TigerPASS</button>';
            var gp = document.getElementById('mod-getpass');
            if (gp){ gp.addEventListener('click', function(){ modal.hide(); openPass(m.name); }); }
        } else {
            foot.innerHTML = '<button type="button" class="btn btn-primary" id="mod-do"><i class="fa-solid fa-download me-1"></i>Install</button>';
            var doBtn = document.getElementById('mod-do');
            if (doBtn){ doBtn.addEventListener('click', function(){ doInstall(d.repo, d.ref, false); }); }
        }
    }

    function doInstall(repo, ref, isUpdate){
        if (!confirm((isUpdate?'Update':'Install')+' this module? Its code will run in your app once active.')) return;
        var b=document.getElementById('mod-do');
        TigerButton.run(b, function(){
            return api('install',{url:repo,ref:ref,force:isUpdate?1:0});
        }).then(function(res){
            if (res.result===1){ window.location=res.redirect||'/system/modules'; return; }
            modal.hide(); fb.innerHTML=''; (res.messages||[]).forEach(function(m){ TigerDOM.notify(fb, m.message, { type: m.class, replace: false }); }); window.scrollTo({top:0,behavior:'smooth'});
        }).catch(function(){});
    }

    document.getElementById('mod-check').addEventListener('click', function(){ var u=urlEl.value.trim(); if(u){ openDetail(u, refEl.value.trim(), {}, this); } });
    urlEl.addEventListener('keydown', function(e){ if(e.key==='Enter'){ document.getElementById('mod-check').click(); } });

    // ---------- upload install (TigerUpload; unchanged) ----------
    var uploadBtn = document.getElementById('mod-upload'), fileEl = document.getElementById('mod-file');
    var dropzone = document.getElementById('mod-dropzone'), dropLabel = document.getElementById('mod-drop-label');
    var prog = document.getElementById('mod-progress'), progBar = document.getElementById('mod-progress-bar');
    var staged = null;

    if (window.TigerUpload && dropzone) {
        var showUploadTab = function(){ var b = document.getElementById('tab-upload-btn'); if (b && window.bootstrap) { bootstrap.Tab.getOrCreateInstance(b).show(); } };
        var up = TigerUpload.create({
            url: '/api', field: 'archive', accept: ['.zip'], maxSize: 50 * 1048576,
            multiple: false, auto: false,
            params: { module: 'system', service: 'modules', method: 'upload' }
        });
        up.fromInput(fileEl);
        up.dropOnWindow({ label: 'Drop your module .zip', sublabel: 'unpacked into your modules folder', onDrop: showUploadTab });
        up.subscribe({
            onAdd: function (item) {
                staged = item;
                dropLabel.innerHTML = '<i class="fa-solid fa-file-zipper text-success me-1"></i>' + esc(item.name) +
                    ' <span class="text-body-secondary">(' + (item.size / 1048576).toFixed(1) + ' MB)</span>';
                dropzone.classList.add('has-file');
                prog.classList.add('d-none'); progBar.style.width = '0%';
                uploadBtn.disabled = false;
            },
            onProgress: function (item) { prog.classList.remove('d-none'); progBar.style.width = item.percent + '%'; },
            onSuccess: function (item) { progBar.style.width = '100%'; window.location = item.redirect || '/system/modules'; },
            onError: function (item) {
                fb.innerHTML = ''; TigerDOM.notify(fb, item.error || 'Upload failed — please try again.', { type: 'error' });
                window.scrollTo({ top: 0, behavior: 'smooth' });
                prog.classList.add('d-none'); uploadBtn.disabled = false;
            },
            onReject: function (info) { TigerDOM.notify(fb, info.error, { type: 'alert' }); }
        });
        dropzone.addEventListener('click', function () { fileEl.click(); });
        dropzone.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileEl.click(); } });
        uploadBtn.addEventListener('click', function () {
            if (!staged) { TigerDOM.notify(fb, 'Choose a .zip package to upload.', { type: 'alert' }); return; }
            if (!confirm('Install this uploaded package? Its code will run in your app once active.')) { return; }
            uploadBtn.disabled = true;
            up.start();
        });
    }

    // ================= registry search + filters + cards =================
    var searchEl=document.getElementById('mod-search'), sortEl=document.getElementById('mod-sort'),
        results=document.getElementById('mod-results'), typeFilter=document.getElementById('mod-type-filter'),
        catFilter=document.getElementById('mod-cat-filter'), availFilter=document.getElementById('mod-avail-filter'), t;
    var allResults=[], activeType='', activeCat='', activeAvail='', grid=null,
        typeLabels={}, catsByType={}, pillsBuilt=false;
    if (searchEl){
        searchEl.addEventListener('input', function(){ clearTimeout(t); t=setTimeout(runSearch,250); });
        if (sortEl){ sortEl.addEventListener('change', runSearch); }
        runSearch();
    }
    function humanize(id){ return String(id||'').replace(/[-_]/g,' ').replace(/\b\w/g,function(c){return c.toUpperCase();}); }
    function setTaxonomy(tax){
        typeLabels={}; catsByType={};
        var types=(tax&&tax.types)||[], cats=(tax&&tax.categories)||[];
        if (!types.length){
            var seen={};
            allResults.forEach(function(m){ var ty=m.type; if(ty && !seen[ty]){ seen[ty]=1; types.push({id:ty,label:humanize(ty)}); } });
            types.sort(function(a,b){ return a.label.localeCompare(b.label); });
        }
        types.forEach(function(ty){ typeLabels[ty.id]=ty.label||humanize(ty.id); });
        cats.forEach(function(c){ (c.types||[]).forEach(function(ty){ (catsByType[ty]=catsByType[ty]||[]).push(c); }); });
        return types;
    }
    function renderTypePills(types){
        if (!typeFilter){ return; }
        var html='<li class="nav-item"><button type="button" class="nav-link'+(activeType===''?' active':'')+'" data-type="">All</button></li>';
        types.forEach(function(ty){
            html+='<li class="nav-item"><button type="button" class="nav-link'+(activeType===ty.id?' active':'')+'" data-type="'+esc(ty.id)+'">'+esc(ty.label||humanize(ty.id))+'</button></li>';
        });
        typeFilter.innerHTML=html;
        typeFilter.querySelectorAll('[data-type]').forEach(function(btn){
            btn.addEventListener('click', function(){
                typeFilter.querySelectorAll('.nav-link').forEach(function(b){ b.classList.remove('active'); });
                btn.classList.add('active');
                activeType=btn.getAttribute('data-type'); activeCat='';
                renderCatPills();
                applyFilter();
            });
        });
        renderCatPills();
    }
    function renderCatPills(){
        if (!catFilter){ return; }
        var cats=catsByType[activeType]||[];
        if (!activeType || !cats.length){ catFilter.innerHTML=''; catFilter.classList.add('d-none'); return; }
        catFilter.classList.remove('d-none');
        var html='<li class="nav-item"><button type="button" class="nav-link'+(activeCat===''?' active':'')+'" data-cat="">All</button></li>';
        cats.forEach(function(c){
            html+='<li class="nav-item"><button type="button" class="nav-link'+(activeCat===c.id?' active':'')+'" data-cat="'+esc(c.id)+'">'+esc(c.label||humanize(c.id))+'</button></li>';
        });
        catFilter.innerHTML=html;
        catFilter.querySelectorAll('[data-cat]').forEach(function(btn){
            btn.addEventListener('click', function(){
                catFilter.querySelectorAll('.nav-link').forEach(function(b){ b.classList.remove('active'); });
                btn.classList.add('active');
                activeCat=btn.getAttribute('data-cat');
                applyFilter();
            });
        });
    }
    // Availability pills are static (the platform's pricing models), wired once.
    if (availFilter){
        availFilter.querySelectorAll('[data-avail]').forEach(function(btn){
            btn.addEventListener('click', function(){
                availFilter.querySelectorAll('.nav-link').forEach(function(b){ b.classList.remove('active'); });
                btn.classList.add('active');
                activeAvail=btn.getAttribute('data-avail');
                applyFilter();
            });
        });
    }

    function runSearch(refresh){
        var data = { q:searchEl.value.trim(), sort:(sortEl?sortEl.value:'featured') };
        if (refresh){ data.refresh = 1; }
        return api('search',data).then(function(res){
            if (res.result!==1) return;
            allResults=(res.data&&res.data.results)||[];
            passHas = !!(res.data && res.data.pass && res.data.pass.has);
            var nag = (res.data && res.data.nag) || {};
            nagShow = nag.show !== false;
            nagDisabled = !!nag.disabled;
            if (!pillsBuilt){ renderTypePills(setTaxonomy(res.data&&res.data.taxonomy)); pillsBuilt=true; }
            renderResults();
            renderBanner();
            renderPassTab({ has: passHas }, { show: nagShow, disabled: nagDisabled });
        });
    }
    var refreshEl = document.getElementById('mod-refresh');
    if (refreshEl){
        refreshEl.addEventListener('click', function(){
            TigerButton.run(this, function(){ return runSearch(true); })
                .then(function(){ if (window.TigerDOM && TigerDOM.toast){ TigerDOM.toast('Directory refreshed.', { type:'success' }); } });
        });
    }
    function catList(m){ var c=m.category; return Array.isArray(c)?c:(c?[c]:[]); }

    // ---- badges + card ----
    // Availability → a themed badge. PASS is amber (🐯); owned PASS shows a check.
    function availBadgeHTML(avail){
        if (avail==='free')     return '<span class="badge text-bg-success-subtle text-success-emphasis border border-success-subtle me-1">free</span>';
        if (avail==='freemium') return '<span class="badge text-bg-info-subtle text-info-emphasis border border-info-subtle me-1">freemium</span>';
        if (avail==='paid')     return '<span class="badge text-bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle me-1">paid</span>';
        if (avail==='pass')     return passHas
            ? '<span class="badge text-bg-warning-subtle text-warning-emphasis border border-warning-subtle me-1"><i class="fa-solid fa-paw me-1"></i>PASS <i class="fa-solid fa-check ms-1"></i></span>'
            : '<span class="badge text-bg-warning-subtle text-warning-emphasis border border-warning-subtle me-1"><i class="fa-solid fa-paw me-1"></i>PASS</span>';
        return '';
    }
    function card(m,i){
        var type = m.type || '';
        var typeBadge = type ? ' <span class="badge text-bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">'+esc(typeLabels[type]||humanize(type))+'</span>' : '';
        var avail = m.availability || '';
        // Sponsored marker is only meaningful under the Featured sort (which surfaces them first); it
        // disappears when the buyer re-sorts, so promotion is always something they can opt past.
        var spon = (m.sponsored && (sortEl?sortEl.value:'featured')==='featured')
            ? ' <span class="badge text-bg-warning-subtle text-warning-emphasis border border-warning-subtle" title="Promoted placement">'+esc(m.sponsored_label||'Sponsored')+'</span>' : '';
        var hero = m.hero ? '<img src="'+esc(m.hero)+'" class="mod-card-hero" alt="" onerror="'+imgErr+'">' : '';

        // Actions. EVERY card keeps "View more" (the review-before-install / read-the-TIGER.md path).
        // A PASS module you don't own ALSO gets the subscription CTA, after it — read about it first,
        // then subscribe. (A PASS module you already own just needs View more → Install.)
        var viewMore = '<button type="button" class="btn btn-sm btn-outline-primary" data-i="'+i+'">View more</button>';
        var getPass  = '<button type="button" class="btn btn-sm btn-warning" data-getpass="'+i+'"><i class="fa-solid fa-paw me-1"></i>Get TigerPASS</button>';
        var action = '<div class="d-flex gap-2 flex-wrap">'+ viewMore + ((avail==='pass' && !passHas) ? getPass : '') +'</div>';

        return '<div class="mod-grid-item" data-type="'+esc(type)+'" data-category="'+esc(catList(m).join(' '))+'" data-avail="'+esc(avail)+'"><div class="mod-grid-item-content card'+(m.sponsored?' border-warning-subtle':'')+'">'+
            hero +
            '<div class="card-body d-flex gap-3">'+
              (m.logo?'<img src="'+esc(m.logo)+'" alt="" class="mod-card-logo" onerror="'+imgErr+'">':'')+
              '<div class="flex-grow-1">'+
                '<h6 class="mb-0">'+esc(m.module||m.slug)+typeBadge+' '+availBadgeHTML(avail)+spon+'</h6>'+
                '<div class="small text-body-secondary mb-1">'+esc(m.vendor||'')+'</div>'+
                '<p class="small text-body-secondary mb-2">'+esc(m.description||'')+'</p>'+
                action+
              '</div>'+
            '</div>'+
          '</div></div>';
    }
    function renderResults(){
        if (grid){ grid.destroy(); grid=null; }
        if (!allResults.length){ results.innerHTML='<div class="text-body-secondary small">No modules match.</div>'; return; }
        results.innerHTML = '<div class="mod-grid">'+allResults.map(card).join('')+'</div>'+
            '<div class="mod-empty text-body-secondary small d-none">No modules match these filters.</div>';
        grid = new Muuri(results.querySelector('.mod-grid'), { dragEnabled:false, layout:{ fillGaps:true } });
        applyFilter();
        results.querySelectorAll('img').forEach(function(img){
            img.addEventListener('load', function(){ if(grid){ grid.refreshItems().layout(); } });
        });
        results.querySelectorAll('[data-i]').forEach(function(b){
            b.addEventListener('click', function(){ var m=allResults[+b.getAttribute('data-i')]; openDetail(m.repository, m.ref, m, this); });
        });
        results.querySelectorAll('[data-getpass]').forEach(function(b){
            b.addEventListener('click', function(){ var m=allResults[+b.getAttribute('data-getpass')]; openPass(m.module||m.slug); });
        });
    }
    function matches(m){
        if (activeType && (m.type||'')!==activeType){ return false; }
        if (activeCat  && catList(m).indexOf(activeCat)<0){ return false; }
        if (activeAvail && (m.availability||'')!==activeAvail){ return false; }
        return true;
    }
    function applyFilter(){
        if (!grid){ return; }
        grid.filter(function(item){
            var el=item.getElement();
            var okType =!activeType  || el.getAttribute('data-type')===activeType;
            var okCat  =!activeCat   || (el.getAttribute('data-category')||'').split(' ').indexOf(activeCat)>=0;
            var okAvail=!activeAvail || el.getAttribute('data-avail')===activeAvail;
            return okType && okCat && okAvail;
        });
        var visible = allResults.filter(matches).length;
        var empty = results.querySelector('.mod-empty');
        if (empty){ empty.classList.toggle('d-none', visible>0); }
    }

    // ================= the TigerPASS funnel =================
    var passModalEl = document.getElementById('pass-modal');
    var passModal = new bootstrap.Modal(passModalEl);
    var passContent = document.getElementById('pass-content');

    function passShelf(){
        // The PASS-covered modules currently in the catalog — the "all this for $5?" shelf.
        var names = allResults.filter(function(m){ return (m.availability||'')==='pass'; })
            .map(function(m){ return m.module||m.slug; });
        // De-dup + cap the visible list; always end with the "future" line.
        var seen={}, uniq=[]; names.forEach(function(n){ if(n && !seen[n]){ seen[n]=1; uniq.push(n); } });
        var rows = uniq.slice(0,7).map(function(n){ return '<div class="col-6 mb-1"><i class="fa-solid fa-check text-success me-2"></i>'+esc(n)+'</div>'; });
        rows.push('<div class="col-6 mb-1 text-body-secondary fst-italic"><i class="fa-solid fa-check text-success me-2"></i>Every future premium module</div>');
        return '<div class="row g-0 small mb-1">'+rows.join('')+'</div>';
    }

    function openPass(refName){
        renderPassPhase1(refName);
        passModal.show();
    }

    function renderPassPhase1(refName){
        var refBar = refName ? '<div class="alert alert-warning py-2 px-3 small d-flex gap-2 mb-3"><i class="fa-solid fa-paw mt-1"></i><div>You clicked <strong>'+esc(refName)+'</strong> — it\'s one of these. TigerPASS unlocks the whole shelf, not just this one.</div></div>' : '';
        passContent.innerHTML =
            '<div class="modal-header border-0 pb-0">'+
              '<div class="d-flex align-items-center gap-3">'+
                '<span class="d-inline-flex align-items-center justify-content-center rounded-3 text-bg-warning" style="width:42px;height:42px;font-size:22px"><i class="fa-solid fa-paw"></i></span>'+
                '<div><h5 class="modal-title mb-0" id="pass-title">Get TigerPASS</h5><div class="small text-body-secondary text-uppercase" style="letter-spacing:.04em">One subscription · every premium module</div></div>'+
              '</div>'+
              '<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>'+
            '</div>'+
            '<div class="modal-body pt-2">'+
              '<p class="mb-2"><strong class="text-warning-emphasis">$5/mo</strong> unlocks every premium module and theme — not just this one. One key, one domain, subdomains free.</p>'+
              refBar +
              passShelf() +
              '<div class="d-grid gap-2 mt-3">'+
                '<button type="button" class="btn btn-warning d-flex align-items-center justify-content-between" data-plan="monthly"><span class="fw-semibold">$5 <span class="fw-normal small">/ month</span></span><i class="fa-solid fa-arrow-right"></i></button>'+
                '<button type="button" class="btn btn-outline-warning d-flex align-items-center justify-content-between" data-plan="yearly"><span class="fw-semibold">$50 <span class="fw-normal small">/ year</span></span><span class="badge text-bg-success-subtle text-success-emphasis border border-success-subtle">2 months free</span></button>'+
              '</div>'+
              '<button type="button" class="btn btn-link btn-sm text-body-secondary d-block mx-auto mt-2" data-bs-dismiss="modal">← or keep browsing free modules</button>'+
              '<p class="text-body-secondary mb-0 mt-1" style="font-size:11px;line-height:1.4">Checkout happens on webtigers.com (Stripe). Your install never sees a card. Lapsing only pauses <em>updates</em> — installed modules keep running.</p>'+
            '</div>';
        passContent.querySelectorAll('[data-plan]').forEach(function(b){
            b.addEventListener('click', function(){ renderPassPhase2(b.getAttribute('data-plan')); });
        });
    }

    function renderPassPhase2(plan){
        var priceLine = plan==='yearly' ? '$50/year' : '$5/month';
        // Open the seller's hosted checkout in a new tab (popup window, never an iframe — 3DS + hosted
        // checkout can't be framed). The modal stays here as the waiting/paste-key state.
        try { window.open(PASS_CHECKOUT + (PASS_CHECKOUT.indexOf('?')<0?'?':'&') + 'plan=' + encodeURIComponent(plan), '_blank', 'noopener'); } catch(e){}
        passContent.innerHTML =
            '<div class="modal-header border-0 pb-0">'+
              '<div class="d-flex align-items-center gap-3">'+
                '<span class="d-inline-flex align-items-center justify-content-center rounded-3 text-bg-warning" style="width:42px;height:42px;font-size:22px"><i class="fa-solid fa-paw"></i></span>'+
                '<div><h5 class="modal-title mb-0" id="pass-title">Complete your purchase</h5><div class="small text-body-secondary text-uppercase" style="letter-spacing:.04em">'+esc(priceLine)+' · checkout opened in a new tab</div></div>'+
              '</div>'+
              '<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>'+
            '</div>'+
            '<div class="modal-body pt-2">'+
              '<p class="d-flex align-items-center gap-2 text-body-secondary small mb-3"><span class="spinner-border spinner-border-sm text-warning"></span> Waiting for your TigerPASS key…</p>'+
              '<label class="form-label small fw-semibold" for="pass-key">Paste your TigerPASS key</label>'+
              '<input type="text" class="form-control font-monospace" id="pass-key" placeholder="TPASS-XXXX-XXXX-XXXX-XXXX-XXXX" autocomplete="off" spellcheck="false" aria-describedby="pass-key-help">'+
              '<div class="invalid-feedback" id="pass-key-err">That key isn\'t valid for this domain. Check it, or resend it to your email from webtigers.com.</div>'+
              '<div class="form-text" id="pass-key-help">Finish checkout in the other tab — your key shows on the confirmation page (and is emailed to you). Paste it here and it activates automatically.</div>'+
              '<div class="mt-3 pt-2 border-top">'+
                '<a href="'+esc(PASS_CHECKOUT)+'" target="_blank" rel="noopener" class="small text-decoration-none"><i class="fa-solid fa-arrow-up-right-from-square me-1"></i>Reopen checkout</a>'+
              '</div>'+
            '</div>';
        var input = document.getElementById('pass-key');
        var errEl = document.getElementById('pass-key-err');
        var pending = false;
        function tryActivate(){
            var v = input.value.trim().toUpperCase();
            input.classList.remove('is-invalid','is-valid');
            if (!/^TPASS-([0-9A-Z]{4}-){4}[0-9A-Z]{4}$/.test(v)) { return; }   // wait for a full, well-formed key
            if (pending) { return; }
            pending = true;
            api('activatePass', { key: v }).then(function(res){
                pending = false;
                if (res.result===1){
                    input.classList.add('is-valid');
                    passHas = true;
                    passModal.hide();
                    if (window.TigerDOM && TigerDOM.toast){ TigerDOM.toast('Welcome to TigerPASS — every premium module is unlocked.', { type:'success' }); }
                    renderResults();     // flip every PASS card to a plain Install
                    renderBanner();      // banner disappears now that PASS is active
                    return;
                }
                input.classList.add('is-invalid');
                var msg = (res.messages && res.messages[0] && res.messages[0].message) || '';
                if (msg && errEl){ errEl.textContent = msg; }
            }).catch(function(){ pending=false; input.classList.add('is-invalid'); });
        }
        input.addEventListener('input', tryActivate);
        input.focus();
    }

    // ---- persistent value banner (only when there's no active PASS, and the user hasn't snoozed/disabled it) ----
    function renderBanner(){
        var slot = document.getElementById('pass-banner');
        if (!slot) return;
        if (passHas || !nagShow){ slot.innerHTML=''; return; }   // active PASS, disabled, or still snoozed → hidden
        var count = allResults.filter(function(m){ return (m.availability||'')==='pass'; }).length;
        if (!count){ slot.innerHTML=''; return; }   // nothing to sell → no banner
        slot.innerHTML =
            '<div class="alert alert-warning d-flex align-items-center gap-3 mb-4" role="alert">'+
              '<i class="fa-solid fa-paw fs-5"></i>'+
              '<div class="flex-grow-1"><strong>TigerPASS — $5/mo</strong> unlocks every premium module and theme. '+
                count+' premium module'+(count===1?'':'s')+' included here, and every future one. <span class="text-body-secondary">Included with your subscription, never per-module.</span></div>'+
              '<button type="button" class="btn btn-sm btn-warning text-nowrap" id="pass-banner-cta">Learn more</button>'+
              '<button type="button" class="btn-close" id="pass-banner-x" aria-label="Dismiss for 30 days" title="Dismiss for 30 days"></button>'+
            '</div>';
        var cta = document.getElementById('pass-banner-cta');
        if (cta){ cta.addEventListener('click', function(){ openPass(null); }); }
        var x = document.getElementById('pass-banner-x');
        if (x){ x.addEventListener('click', function(){
            nagShow = false;
            var alertEl = slot.querySelector('.alert');
            if (window.TigerDOM && TigerDOM.collapse && alertEl){ TigerDOM.collapse(alertEl); setTimeout(function(){ slot.innerHTML=''; }, 450); }
            else { slot.innerHTML=''; }
            api('snoozePassNag', {});   // persist the 30-day snooze (per user)
        }); }
    }

    // ---- TigerPASS tab: status + the "Disable TigerPASS nag alert" switch ----
    function renderPassTab(pass, nag){
        var toggle = document.getElementById('pass-nag-toggle');
        var status = document.getElementById('pass-tab-status');
        if (toggle && nag){ toggle.checked = !!nag.disabled; }
        if (status){
            status.innerHTML = (pass && pass.has)
                ? '<div class="alert alert-success d-flex align-items-center gap-2 mb-0"><i class="fa-solid fa-circle-check"></i><div>TigerPASS is <strong>active</strong> on this install — every premium module and theme is unlocked.</div></div>'
                : '<div class="alert alert-warning d-flex align-items-center gap-2 mb-0"><i class="fa-solid fa-paw"></i><div>No active TigerPASS. Unlock the whole premium shelf from any premium module’s card.</div></div>';
        }
    }
    var passTabBtn = document.getElementById('tab-pass-btn');
    if (passTabBtn){
        passTabBtn.addEventListener('shown.bs.tab', function(){
            // Fetch fresh status even when the registry (and its search) is unreachable.
            api('passInfo', {}).then(function(res){ if (res.result===1){ renderPassTab(res.data.pass, res.data.nag); } });
        });
    }
    var passNagToggle = document.getElementById('pass-nag-toggle');
    if (passNagToggle){
        passNagToggle.addEventListener('change', function(){
            var on = passNagToggle.checked;
            api('setPassNag', { disabled: on ? 1 : 0 }).then(function(res){
                if (res.result === 1){
                    nagDisabled = !!(res.data.nag && res.data.nag.disabled);
                    nagShow = res.data.nag ? (res.data.nag.show !== false) : nagShow;
                    renderBanner();
                    if (window.TigerDOM && TigerDOM.toast){ TigerDOM.toast(on ? 'TigerPASS nag alert disabled.' : 'TigerPASS nag alert enabled.', { type:'success' }); }
                } else {
                    passNagToggle.checked = !on;   // revert on failure
                    (res.messages||[]).forEach(function(m){ TigerDOM.notify(fb, m.message, { type: m.class }); });
                }
            }).catch(function(){ passNagToggle.checked = !on; });
        });
    }

    // ---- Marketplaces tab: list + connect + manage catalog sources ----
    var srcList = document.getElementById('src-list');
    function kindLabel(k){ return k === 'git-index' ? 'Directory' : 'Marketplace'; }
    function kindBadge(k){ return '<span class="badge text-bg-light border">'+esc(kindLabel(k))+'</span>'; }
    function originBadge(o){
        if (o === 'default') return '<span class="badge text-bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">Built-in</span>';
        if (o === 'module')  return '<span class="badge text-bg-info-subtle text-info-emphasis border border-info-subtle">Module</span>';
        return '<span class="badge text-bg-success-subtle text-success-emphasis border border-success-subtle">Connected</span>';
    }
    function renderSources(list){
        if (!srcList) return;
        if (!list || !list.length){ srcList.innerHTML = '<div class="text-body-secondary small">No sources.</div>'; return; }
        var rows = list.map(function(s){
            var provider = s.provider ? ' <span class="small text-body-secondary">· '+esc(s.provider)+'</span>' : '';
            var remove = (s.origin === 'connected')
                ? '<button type="button" class="btn btn-sm btn-outline-danger" data-src-remove="'+esc(s.id)+'" aria-label="Remove" title="Remove"><i class="fa-solid fa-trash"></i></button>'
                : '<span class="text-body-secondary small" title="Built-in and module sources can be disabled but not removed">—</span>';
            return '<tr>'+
                '<td><div class="fw-semibold">'+esc(s.label||s.id)+'</div>'+
                    '<div class="small">'+kindBadge(s.kind)+' '+originBadge(s.origin)+provider+'</div></td>'+
                '<td class="small text-body-secondary text-truncate" style="max-width:260px" title="'+esc(s.url||'')+'">'+esc(s.url||'—')+'</td>'+
                '<td style="width:88px"><input type="number" class="form-control form-control-sm" value="'+(parseInt(s.priority,10)||0)+'" min="0" aria-label="Priority" data-src-priority="'+esc(s.id)+'"></td>'+
                '<td style="width:64px"><div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" role="switch" '+(s.enabled?'checked':'')+' aria-label="Enabled" data-src-enabled="'+esc(s.id)+'"></div></td>'+
                '<td class="text-end" style="width:56px">'+remove+'</td>'+
            '</tr>';
        }).join('');
        srcList.innerHTML =
            '<table class="table table-sm align-middle mb-0">'+
              '<thead><tr class="small text-body-secondary"><th>Name</th><th>Index URL</th><th>Priority</th><th>On</th><th></th></tr></thead>'+
              '<tbody>'+rows+'</tbody></table>';
        srcList.querySelectorAll('[data-src-enabled]').forEach(function(el){
            el.addEventListener('change', function(){ updateSource(el.getAttribute('data-src-enabled'), { enabled: el.checked ? 1 : 0 }); });
        });
        srcList.querySelectorAll('[data-src-priority]').forEach(function(el){
            el.addEventListener('change', function(){ updateSource(el.getAttribute('data-src-priority'), { priority: el.value }); });
        });
        srcList.querySelectorAll('[data-src-remove]').forEach(function(el){
            el.addEventListener('click', function(){
                if (!confirm('Remove this marketplace? Modules already installed from it stay installed.')) return;
                api('removeSource', { id: el.getAttribute('data-src-remove') }).then(handleSrcResp);
            });
        });
    }
    function updateSource(id, data){ api('updateSource', Object.assign({ id: id }, data)).then(function(res){ handleSrcResp(res, true); }); }
    function handleSrcResp(res, quiet){
        if (res.result === 1){
            if (res.data && res.data.sources){ renderSources(res.data.sources); }
            if (!quiet){ (res.messages||[]).forEach(function(m){ if (window.TigerDOM && TigerDOM.toast){ TigerDOM.toast(m.message, { type:m.class }); } }); }
        } else {
            (res.messages||[]).forEach(function(m){ if (window.TigerDOM && TigerDOM.toast){ TigerDOM.toast(m.message, { type:m.class }); } });
        }
    }
    function loadSources(){ api('sources', {}).then(function(res){ if (res.result===1){ renderSources(res.data.sources); } }); }
    var srcTabBtn = document.getElementById('tab-sources-btn');
    if (srcTabBtn){ srcTabBtn.addEventListener('shown.bs.tab', loadSources); }
    var srcConnectBtn = document.getElementById('src-connect');
    if (srcConnectBtn){
        srcConnectBtn.addEventListener('click', function(){
            var label = document.getElementById('src-label').value.trim();
            var url   = document.getElementById('src-url').value.trim();
            var kind  = document.getElementById('src-kind').value;
            var fbSrc = document.getElementById('src-connect-feedback');
            TigerButton.run(this, function(){ return api('connectSource', { label:label, url:url, kind:kind }); })
              .then(function(res){
                  if (res.result === 1){
                      document.getElementById('src-label').value=''; document.getElementById('src-url').value='';
                      renderSources(res.data.sources);
                      TigerDOM.notify(fbSrc, (res.messages && res.messages[0] && res.messages[0].message) || 'Connected.', { type:'success' });
                      if (searchEl && typeof runSearch === 'function'){ runSearch(true); }   // pull the new source into Browse
                  } else {
                      (res.messages||[]).forEach(function(m){ TigerDOM.notify(fbSrc, m.message, { type:m.class }); });
                  }
              }).catch(function(){ TigerDOM.notify(fbSrc, 'Network error.', { type:'error' }); });
        });
    }
});
</script>
