$form = $this->form;
$el = function ($name) use ($form) { return $form->getElement($name); };
// v3 site key for the JS to mint a token before this button-click AJAX submit (empty when off / v2).
$rcSite = (class_exists('Tiger_Recaptcha') && Tiger_Recaptcha::isEnabled() && Tiger_Recaptcha::version() === 'v3')
    ? (string) Tiger_Recaptcha::siteKey() : '';
// Localized strings this page's JS references — delivered via the carrier + tiger.i18n.js, not inline.
$this->i18n([
    'verifySent'   => 'signup.js.verify_sent',
    'fixFields'    => 'signup.js.fix_fields',
    'checkField'   => 'signup.js.check_field',
    'wentWrong'    => 'signup.js.went_wrong',
    'networkError' => 'signup.js.network_error',
]);
?>
