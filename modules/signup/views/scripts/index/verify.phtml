/**
 * Email-verification result (rendered in the auth layout). ok=true → account activated;
 * else the link was invalid/expired.
 */
?>
<div class="tiger-auth-brand">
    <span class="tiger-auth-mark"><i class="fa-solid fa-paw"></i></span>
    <h1 class="h4 mb-1"><?= $this->escape($this->t('signup.verify.heading')) ?></h1>
</div>

<?php if ($this->ok): ?>
    <div class="alert alert-success d-flex align-items-start gap-2" role="alert">
        <i class="fa-solid fa-circle-check mt-1"></i>
        <div><?= $this->escape($this->t('signup.verify.success.body')) ?></div>
    </div>
    <div class="d-grid">
        <a href="/auth/login" class="btn btn-primary"><i class="fa-solid fa-right-to-bracket me-2"></i><?= $this->escape($this->t('signup.verify.action.signin')) ?></a>
    </div>
<?php else: ?>
    <div class="alert alert-danger d-flex align-items-start gap-2" role="alert">
        <i class="fa-solid fa-circle-exclamation mt-1"></i>
        <div><?= $this->escape($this->t('signup.verify.invalid.body')) ?></div>
    </div>
    <div class="d-grid">
        <a href="/signup" class="btn btn-outline-secondary"><i class="fa-solid fa-angle-left me-2"></i><?= $this->escape($this->t('signup.verify.action.back')) ?></a>
    </div>
<?php endif; ?>
