    <?= $this->partial('admin/_agent-card.phtml', [
        'a' => [
            'agent_id' => '', 'name' => '', 'persona' => '', 'provider' => $this->defaultProvider,
            'model' => '', 'enabled' => true, 'is_default' => false, 'connected' => false,
        ],
        'providers' => $providers,
        't'         => $t,
        'escape'    => [$this, 'escape'],
    ]) ?>
</template>

<?php
$this->i18n([
    'modelsLive'    => 'agent.js.models_live',
    'modelsStatic'  => 'agent.js.models_static',
    'networkError'  => 'agent.js.network_error',
    'settingsSaved' => 'agent.js.settings_saved',
    'agentSaved'    => 'agent.js.agent_saved',
    'agentDeleted'  => 'agent.js.agent_deleted',
    'confirmDelete' => 'agent.js.confirm_delete',
    'nameRequired'  => 'agent.js.name_required',
]);
?>
<script>
(function () {
    var csrf = document.querySelector('[name="_csrf"]');
    var csrfVal = csrf ? csrf.value : '';
    var fb = document.getElementById('agent-feedback');

    function api(method, extra) {
        var fd = new URLSearchParams();
        fd.set('module', 'agent'); fd.set('service', 'agents'); fd.set('method', method);
        if (csrfVal) { fd.set('_csrf', csrfVal); }
        Object.keys(extra || {}).forEach(function (k) { fd.set(k, extra[k]); });
        return fetch('/api', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' }, body: fd })
            .then(function (r) { return r.json().catch(function () { return {}; }); });
    }

    // Live model list for one card: from the provider when a key is available (typed here, else the
    // stored one), otherwise the curated static fallback (agent/settings/models).
    function loadModels(card) {
        var provider = card.querySelector('.agent-provider').value;
        var keyEl    = card.querySelector('.agent-key');
        var sel      = card.querySelector('.agent-model');
        var hint     = card.querySelector('.agent-model-hint');
        var current  = sel.value;
        var fd = new URLSearchParams();
        fd.set('module', 'agent'); fd.set('service', 'settings'); fd.set('method', 'models');
        fd.set('provider', provider);
        if (keyEl && keyEl.value.trim()) { fd.set('api_key', keyEl.value.trim()); }
        if (card.dataset.agentId) { fd.set('agent_id', card.dataset.agentId); }
        hint.textContent = '…';
        fetch('/api', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' }, body: fd })
            .then(function (r) { return r.json().catch(function () { return {}; }); })
            .then(function (res) {
                if (!res || res.result !== 1 || !res.data || !res.data.models) { hint.textContent = ''; return; }
                sel.innerHTML = '';
                res.data.models.forEach(function (m) {
                    var o = document.createElement('option');
                    o.value = m.id; o.textContent = m.label || m.id;
                    if (m.id === current) { o.selected = true; }
                    sel.appendChild(o);
                });
                if (!sel.value && sel.options.length) { sel.selectedIndex = 0; }
                hint.textContent = res.data.live ? Tiger.t('modelsLive') : Tiger.t('modelsStatic');
            })
            .catch(function () { hint.textContent = ''; });
    }

    function refreshEmpty() {
        var any = document.querySelectorAll('#agent-cards .agent-card').length > 0;
        document.getElementById('agent-empty').hidden = any;
    }

    function wire(card) {
        card.querySelector('.agent-provider').addEventListener('change', function () { loadModels(card); });
        card.querySelector('.agent-model-refresh').addEventListener('click', function () { loadModels(card); });

        card.querySelector('.agent-save').addEventListener('click', function () {
            var name = card.querySelector('.agent-name').value.trim();
            if (!name) { TigerDOM.notify(fb, Tiger.t('nameRequired'), { type: 'error' }); return; }
            var payload = {
                agent_id:   card.dataset.agentId || '',
                name:       name,
                persona:    card.querySelector('.agent-persona').value,
                provider:   card.querySelector('.agent-provider').value,
                model:      card.querySelector('.agent-model').value,
                api_key:    card.querySelector('.agent-key').value.trim(),
                enabled:    card.querySelector('.agent-enabled').checked ? '1' : '',
                is_default: card.querySelector('.agent-default').checked ? '1' : ''
            };
            TigerButton.run(this, function () { return api('save', payload); }).then(function (res) {
                if (res && res.result === 1 && res.data && res.data.agent) {
                    var ag = res.data.agent;
                    card.dataset.agentId = ag.agent_id;
                    card.querySelector('.agent-key').value = '';           // clear write-only field
                    card.querySelector('.agent-connected').hidden = !ag.connected;
                    card.querySelector('.agent-disconnected').hidden = ag.connected;
                    if (ag.is_default) { card.querySelector('.agent-default').checked = true; }
                    TigerDOM.notify(fb, Tiger.t('agentSaved'), { type: 'success' });
                    return;
                }
                (res && res.messages || []).forEach(function (m) { TigerDOM.notify(fb, m.message, { type: m.class }); });
            }).catch(function () { TigerDOM.notify(fb, Tiger.t('networkError'), { type: 'error' }); });
        });

        card.querySelector('.agent-delete').addEventListener('click', function () {
            var id = card.dataset.agentId || '';
            if (!id) { card.remove(); refreshEmpty(); return; }   // unsaved card — just drop it
            if (!window.confirm(Tiger.t('confirmDelete'))) { return; }
            TigerButton.run(this, function () { return api('delete', { agent_id: id }); }).then(function (res) {
                if (res && res.result === 1) {
                    card.remove(); refreshEmpty();
                    TigerDOM.notify(fb, Tiger.t('agentDeleted'), { type: 'success' });
                    return;
                }
                (res && res.messages || []).forEach(function (m) { TigerDOM.notify(fb, m.message, { type: m.class }); });
            }).catch(function () { TigerDOM.notify(fb, Tiger.t('networkError'), { type: 'error' }); });
        });

        loadModels(card);
    }

    document.querySelectorAll('#agent-cards .agent-card').forEach(wire);
    refreshEmpty();

    document.getElementById('agent-add').addEventListener('click', function () {
        var tpl  = document.getElementById('agent-card-tpl');
        var node = tpl.content.firstElementChild.cloneNode(true);
        document.getElementById('agent-cards').appendChild(node);
        wire(node);
        refreshEmpty();
        node.querySelector('.agent-name').focus();
    });

    document.getElementById('agent-mode-save').addEventListener('click', function () {
        var mode = document.getElementById('agent-mode_max').value;
        var fd = new URLSearchParams();
        fd.set('module', 'agent'); fd.set('service', 'settings'); fd.set('method', 'mode');
        if (csrfVal) { fd.set('_csrf', csrfVal); }
        fd.set('mode_max', mode);
        TigerButton.run(this, function () {
            return fetch('/api', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' }, body: fd })
                .then(function (r) { return r.json().catch(function () { return {}; }); });
        }).then(function (res) {
            if (res && res.result === 1) { TigerDOM.notify(fb, Tiger.t('settingsSaved'), { type: 'success' }); return; }
            (res && res.messages || []).forEach(function (m) { TigerDOM.notify(fb, m.message, { type: m.class }); });
        }).catch(function () { TigerDOM.notify(fb, Tiger.t('networkError'), { type: 'error' }); });
    });
})();
</script>
