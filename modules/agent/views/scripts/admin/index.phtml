        <h1 class="h3 mb-1"><i class="fa-solid fa-robot me-2"></i><?= $this->escape($t('agent.settings.title')) ?></h1>
        <p class="text-body-secondary mb-0"><?= $this->escape($t('agent.settings.subtitle')) ?></p>
    </div>
    <div class="text-nowrap">
        <button type="button" id="agent-add" class="btn btn-primary">
            <i class="fa-solid fa-plus me-2"></i><?= $this->escape($t('agent.agents.add')) ?>
        </button>
    </div>
</div>

