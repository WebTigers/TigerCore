<div id="reg-feedback"></div>

<div class="row g-4"><div class="col-lg-8"><div class="card">
    <div class="card-header fw-semibold"><i class="fa-solid fa-id-badge me-2"></i><?= $this->t('register.status') ?></div>
    <div class="card-body">
        <?php if ($s['verified']): ?>
            <span class="badge text-bg-success"><?= $this->t('register.verified') ?></span>
            <dl class="row mt-3 mb-0 small">
                <dt class="col-sm-3 text-body-secondary"><?= $this->t('register.field.domain') ?></dt><dd class="col-sm-9"><?= htmlspecialchars((string) $s['domain']) ?></dd>
                <dt class="col-sm-3 text-body-secondary"><?= $this->t('register.field.email') ?></dt><dd class="col-sm-9"><?= htmlspecialchars((string) $s['email']) ?></dd>
                <dt class="col-sm-3 text-body-secondary"><?= $this->t('register.field.tsid') ?></dt><dd class="col-sm-9"><code><?= htmlspecialchars((string) $s['tsid']) ?></code></dd>
