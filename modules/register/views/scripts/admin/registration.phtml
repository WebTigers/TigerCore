                <?= $this->t('register.intro_body') ?>
            </p>
            <form id="reg-form" onsubmit="return false;" novalidate>
                <?= $this->form->getElement('_csrf') ?>
                <label class="form-label" for="reg-email"><?= $this->t('register.admin_email') ?></label>
                <div class="input-group" style="max-width:28rem;">
                    <?= $this->form->getElement('email') ?>
                    <button type="button" id="reg-register" class="btn btn-primary"><i class="fa-solid fa-check me-2"></i><?= $this->t('register.register_btn') ?></button>
